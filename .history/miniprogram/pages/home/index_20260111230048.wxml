<view class="home-container">
  <view class="noise-overlay"></view>

  <view class="top-slogan">如果人生可以重来...</view>

  <view class="hero-collage">
    <view class="doodle-star star-1">✦</view>
    <view class="doodle-star star-2">✨</view>
    
    <image 
      class="obj-item obj-gamepad float-delay-1" 
      src="{{images.gamepad || 'cloud://cloud1-2gygzrzj1714d360.636c-cloud1-2gygzrzj1714d360-1394992833/images/home/gamepad.png'}}" 
      mode="widthFix" 
    />
    
    <image 
      class="obj-item obj-letter float-delay-2" 
      src="{{images.letter || 'cloud://cloud1-2gygzrzj1714d360.636c-cloud1-2gygzrzj1714d360-1394992833/images/home/letter.png'}}" 
      mode="widthFix" 
    />
    
    <image 
      class="obj-item obj-coffee float-delay-3" 
      src="{{images.coffee || 'cloud://cloud1-2gygzrzj1714d360.636c-cloud1-2gygzrzj1714d360-1394992833/images/home/coffee.png'}}" 
      mode="widthFix" 
    />
    
    <image 
      class="obj-item obj-main float-delay-0" 
      src="{{images.cat || 'cloud://cloud1-2gygzrzj1714d360.636c-cloud1-2gygzrzj1714d360-1394992833/images/home/cat1.png'}}" 
      mode="widthFix" 
    />
  </view>

  <view class="title-area">
    <text class="main-title">16人格·人生剧本</text>
    <text class="sub-title">如果人生是一部可以重剪的电影，这一次，请按照你最喜欢的样子去演</text>
  </view>

  <view class="receipt-card">
    <view class="receipt-line">No. {{userCode}} 位体验者</view>
    <view class="receipt-line time">档案建立日：{{dateStr}}</view>
    <view class="receipt-barcode">||| || ||| | ||</view>
  </view>

  <view class="start-btn" bindtap="onStartTap" hover-class="btn-pressed">
    <text>开启人生重启计划</text>
  </view>
</view>
