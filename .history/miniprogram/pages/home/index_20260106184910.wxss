.home-container {
  width: 100vw;
  height: 100vh;
  background-color: #FFFDF5; /* 蛋壳暖白 */
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 噪点层 */
.noise-overlay {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  opacity: 0.4;
  pointer-events: none;
  z-index: 1;
  mix-blend-mode: multiply;
  /* 暂无图片时可忽略背景图，仅保留占位 */
}

/* 顶部文案 */
.top-slogan {
  position: relative;
  z-index: 10;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 28rpx;
  color: #888888;
  letter-spacing: 8rpx;
  margin-top: 14vh;
  opacity: 0;
  animation: fadeIn 2s ease-out 0.5s forwards;
}

/* 拼贴区域 */
.hero-collage {
  position: relative;
  z-index: 5;
  width: 100%;
  height: 500rpx;
  margin-top: 40rpx;
}

.obj-item {
  position: absolute;
  will-change: transform;
  filter: drop-shadow(0 10rpx 20rpx rgba(0,0,0,0.1));
}

/* 物件布局微调 */
.obj-gamepad { width: 180rpx; top: 50rpx; left: 80rpx; transform: rotate(-15deg); z-index: 1; }
.obj-letter { width: 200rpx; top: 20rpx; right: 80rpx; transform: rotate(10deg); z-index: 2; }
.obj-coffee { width: 140rpx; bottom: 80rpx; left: 120rpx; transform: rotate(5deg); z-index: 3; }
.obj-main { width: 260rpx; top: 100rpx; left: 50%; margin-left: -130rpx; z-index: 10; }

.doodle-star {
  position: absolute;
  color: #E0C3FC;
  font-size: 40rpx;
  opacity: 0.6;
  animation: twinkle 3s infinite;
}
.star-1 { top: 100rpx; left: 20%; }
.star-2 { bottom: 100rpx; right: 20%; font-size: 30rpx; color: #8EC5FC; }

/* 标题 */
.title-area {
  position: relative;
  z-index: 10;
  text-align: center;
  margin-top: -20rpx;
}
.main-title {
  display: block;
  font-family: "Didot", "Songti SC", serif;
  font-size: 80rpx;
  color: #4A3B3B;
  font-weight: bold;
  letter-spacing: -2rpx;
  text-shadow: 0 4rpx 0px rgba(0,0,0,0.1);
}
.sub-title {
  display: block;
  font-size: 24rpx;
  color: #9E9E9E;
  letter-spacing: 6rpx;
  margin-top: 10rpx;
  text-transform: uppercase;
}

/* 身份小票 */
.receipt-card {
  position: absolute;
  z-index: 8;
  right: 40rpx;
  bottom: 240rpx;
  background: #fff;
  padding: 20rpx 30rpx;
  border: 1px solid #eee;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
  transform: rotate(-6deg);
  opacity: 0;
  animation: slideInUp 1s ease-out 1s forwards;
}
.receipt-line {
  font-family: "Courier New", monospace;
  font-size: 20rpx;
  color: #666;
  line-height: 1.6;
}
.receipt-barcode { font-size: 16rpx; letter-spacing: 2rpx; margin-top: 8rpx; opacity: 0.5; }

/* 按钮 */
.start-btn {
  position: absolute;
  z-index: 20;
  bottom: 100rpx;
  left: 15%;
  width: 70%;
  height: 112rpx;
  border-radius: 56rpx;
  background: linear-gradient(90deg, #E0C3FC 0%, #8EC5FC 100%);
  box-shadow: 0 20rpx 40rpx rgba(142, 197, 252, 0.4);
  display: flex; align-items: center; justify-content: center;
  animation: breath 4s infinite ease-in-out;
}
.start-btn text { color: #fff; font-size: 36rpx; font-weight: 600; letter-spacing: 4rpx; }
.btn-pressed { transform: scale(0.98); opacity: 0.9;box-shadow: 0 2rpx 8rpx -4rpx rgba(0, 0, 0, 0.2) !important;}

/* 动画定义 */
@keyframes fadeIn { from { opacity: 0; } to { opacity:1; } }
@keyframes slideInUp { from { opacity: 0; transform: translateY(20rpx) rotate(-6deg); } to { opacity: 1; transform: translateY(0) rotate(-6deg); } }
@keyframes breath { 
  0% { transform: scale(1); box-shadow: 0 20rpx 40rpx rgba(142, 197, 252, 0.4); }
  50% { transform: scale(1.02); box-shadow: 0 30rpx 60rpx rgba(142, 197, 252, 0.6); }
  100% { transform: scale(1); box-shadow: 0 20rpx 40rpx rgba(142, 197, 252, 0.4); }
}
@keyframes float { 
  0% { transform: translateY(0); } 50% { transform: translateY(-15rpx); } 100% { transform: translateY(0); } 
}
.float-delay-0 { animation: float 4s ease-in-out infinite; }
.float-delay-1 { animation: float 5s ease-in-out 0.5s infinite; }
.float-delay-2 { animation: float 6s ease-in-out 1s infinite; }
.float-delay-3 { animation: float 5.5s ease-in-out 2s infinite; }
@keyframes twinkle { 0%, 100% { opacity: 0.3; transform: scale(0.8); } 50% { opacity: 0.8; transform: scale(1.2); } }
