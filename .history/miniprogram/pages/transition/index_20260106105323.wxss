/* 容器：深色模式，营造沉浸感 */
.transition-container {
  width: 100vw;
  height: 100vh;
  background-color: #1A1A1A; /* 或者保持 #FFFDF5 暖白，看你喜好。这里推荐深色，更有过场感 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  
  /* 关键：CSS 动效过渡 */
  transition: opacity 0.6s ease-in-out; 
}

/* 内部内容区 */
.content-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

/* 章节号 (英文) */
.chapter-no {
  font-family: "Didot", serif;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4); /* 若背景是深色 */
  letter-spacing: 6rpx;
  margin-bottom: 20rpx;
  text-transform: uppercase;
}

/* 主标题 (中文) */
.main-title {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 80rpx;
  color: #E0D4F7; /* 莫兰迪紫，呼应之前的 UI */
  font-weight: bold;
  letter-spacing: 10rpx;
  margin-bottom: 40rpx;
  
  /* 呼吸动效 */
  animation: breath 4s infinite ease-in-out;
}

/* 分割线 */
.divider-line {
  width: 60rpx;
  height: 2rpx;
  background-color: rgba(255, 255, 255, 0.3);
  margin-bottom: 40rpx;
}

/* 副标题 (叙事) */
.sub-text {
  font-family: "Songti SC", serif;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 4rpx;
  font-weight: 300;
  text-align: center;
  max-width: 80%;
  line-height: 1.8;
}

/* 底部跳过提示 */
.skip-hint {
  position: absolute;
  bottom: 80rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.2);
  letter-spacing: 2rpx;
}

/* 装饰边框 (四角相框感) */
.border-frame {
  position: absolute;
  top: 40rpx; left: 40rpx; right: 40rpx; bottom: 40rpx;
  border: 1px solid rgba(255, 255, 255, 0.05);
  pointer-events: none;
}

@keyframes breath {
  0%, 100% { opacity: 0.9; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.02); text-shadow: 0 0 20rpx rgba(224, 212, 247, 0.4); }
}
