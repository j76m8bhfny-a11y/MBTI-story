<view class="container">
  <!-- 正常模式 -->
  <view wx:if="{{!isGuestMode}}" class="normal-mode">
    <view class="hero-section">
      <text class="hero-title">重启人生</text>
      <text class="hero-subtitle">探索你的灵魂配方</text>
    </view>
    
    <view class="action-section">
      <button class="btn-start" bindtap="onStartTest">
        <text class="btn-text">开始测试</text>
      </button>
    </view>
  </view>

  <!-- 访客模式 -->
  <view wx:if="{{isGuestMode && guestData}}" class="guest-mode">
    <view class="guest-header">
      <text class="guest-title">{{guestData.nick}} 的测试结果</text>
      <text class="guest-mbti">{{guestData.mbti}}</text>
    </view>

    <view class="guest-content">
      <view class="result-card">
        <view class="mbti-display">{{guestData.mbti}}</view>
        <view class="result-desc">
          <text>这是 {{guestData.nick}} 的 MBTI 测试结果</text>
          <text>点击下方按钮开始你自己的测试</text>
        </view>
      </view>
    </view>

    <view class="guest-actions">
      <button class="btn-reset" bindtap="onResetToNormal">
        <text class="btn-text">我也要测</text>
      </button>
    </view>
  </view>
</view>
