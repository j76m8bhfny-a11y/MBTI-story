/* 全局容器 */
.container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(135deg, #FFFBF5 0%, #F3E5F5 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

/* === 正常模式 === */
.normal-mode {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-section {
  text-align: center;
  margin-bottom: 80rpx;
}

.hero-title {
  font-family: "Didot", serif;
  font-size: 80rpx;
  font-weight: bold;
  color: #6A4C9C;
  line-height: 1.2;
  margin-bottom: 20rpx;
}

.hero-subtitle {
  font-size: 32rpx;
  color: #666;
  letter-spacing: 4rpx;
}

.action-section {
  width: 100%;
  display: flex;
  justify-content: center;
}

.btn-start {
  width: 400rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #6A4C9C, #9575CD);
  border-radius: 50rpx;
  box-shadow: 0 20rpx 40rpx rgba(106, 76, 156, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-text {
  color: #FFF;
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* === 访客模式 === */
.guest-mode {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guest-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.guest-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.guest-mbti {
  font-family: "Didot", serif;
  font-size: 120rpx;
  font-weight: bold;
  color: #6A4C9C;
  line-height: 1;
}

.guest-content {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 60rpx;
}

.result-card {
  width: 600rpx;
  background: #FFF;
  border-radius: 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.1);
  padding: 60rpx 40rpx;
  text-align: center;
}

.mbti-display {
  font-family: "Didot", serif;
  font-size: 100rpx;
  font-weight: bold;
  color: #6A4C9C;
  margin-bottom: 30rpx;
}

.result-desc {
  color: #666;
  line-height: 1.8;
}

.result-desc text {
  display: block;
  margin-bottom: 10rpx;
}

.guest-actions {
  width: 100%;
  display: flex;
  justify-content: center;
}

.btn-reset {
  width: 400rpx;
  height: 100rpx;
  background: #FFF;
  border: 2rpx solid #6A4C9C;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 20rpx rgba(106, 76, 156, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-reset .btn-text {
  color: #6A4C9C;
}
