/* 全局设定 */
page {
  background-color: #FFFDF9; /* 暖米白 */
  font-family: "Songti SC", "SimSun", serif;
  height: 100vh; overflow: hidden;
}
.page-container {
  width: 100%; height: 100%; position: relative;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  perspective: 1500rpx; /* 3D透视 */
}

/* 噪点 & 模糊背景 */
.noise-overlay {
  position: absolute; top:0; left:0; width:100%; height:100%;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E");
  pointer-events: none; z-index: 1; opacity: 0.4;
}
.bg-blur {
  position: absolute; top:0; left:0; width:100%; height:100%; opacity:0.1; filter:blur(50px); z-index: 0;
}

/* === 核心卡片容器 === */
.result-card {
  width: 680rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 40rpx 80rpx rgba(0,0,0,0.08); /* 柔和阴影 */
  z-index: 10;
  position: relative;
  opacity: 0; transform: translateY(60rpx);
  transition: all 0.8s ease-out;
  overflow: visible; /* 允许锯齿溢出 */
}
/* 归位后滑入 */
.page-container.docked .result-card {
  opacity: 1; transform: translateY(0);
}

/* --- [A] 头部身份区 (Magazine Header) --- */
.card-header {
  padding: 120rpx 40rpx 20rpx 40rpx;
  display: flex; flex-direction: row;
  position: relative;
}
.header-text { flex: 1.5; display: flex; flex-direction: column; }
.header-slot-right { flex: 1; /* 留给塔罗牌 */ }

.mbti-huge {
  font-family: "Didot", serif; font-size: 100rpx; font-weight: bold;
  color: #6A4C9C; line-height: 1; margin-bottom: 16rpx;
  position: relative;
}
.sparkle-icon { font-size: 40rpx; position: absolute; top: -10rpx; left: -30rpx; }
.role-title { font-size: 34rpx; font-weight: 900; color: #333; margin-bottom: 16rpx; letter-spacing: 2rpx;}
.slogan-box { width: 90%; }
.slogan-text { font-size: 24rpx; color: #666; line-height: 1.5; text-align: justify; }

/* --- [B] 动态趋势区 (Trends) --- */
.trends-section {
  margin-top: 20rpx;
  padding: 20rpx 50rpx 10rpx 50rpx;
  width: 100%; box-sizing: border-box;
}
.trend-row { margin-bottom: 24rpx; }

/* 信息层 */
.trend-info {
  display: flex; align-items: center; height: 44rpx; margin-bottom: 8rpx;
}
.char-group { display: flex; align-items: center; gap: 12rpx; transition: all 0.3s; }
.char { font-family: "Didot", serif; font-size: 32rpx; }

/* 赢家样式 */
.char-group.winner .char { font-size: 38rpx; font-weight: bold; color: #6A4C9C; }
.char-group.loser .char { font-size: 32rpx; color: #D0D0D0; }

/* 胶囊标签 */
.status-pill {
  background: #F3E5F5; color: #6A4C9C; font-size: 20rpx;
  padding: 4rpx 16rpx; border-radius: 20rpx; font-weight: bold;
}
.spacer { flex: 1; }

/* 进度条层 */
.trend-bar { height: 6rpx; background: #F5F5F5; border-radius: 6rpx; position: relative; }
.bar-fill { height: 100%; background: #D1C4E9; border-radius: 6rpx; }
.bar-dot {
  position: absolute; top: 50%; transform: translate(-50%, -50%);
  width: 14rpx; height: 14rpx; background: #6A4C9C; border-radius: 50%;
  box-shadow: 0 0 0 4rpx #FFF, 0 4rpx 8rpx rgba(106, 76, 156, 0.3);
}

/* --- [divider] 撕裂线 --- */
.tear-line {
  height: 40rpx; background: #FFFFFF; position: relative;
  display: flex; align-items: center;
  overflow: hidden; /* 确保内容不溢出 */
}
.notch-l, .notch-r {
  width: 24rpx; height: 40rpx; background: #FFFDF9; /* 与页面背景同色 */
  position: absolute; top:0; z-index:2;
}
.notch-l { left:0; border-radius: 0 20rpx 20rpx 0; }
.notch-r { right:0; border-radius: 20rpx 0 0 20rpx; }
.dash-line { flex:1; height:2px; margin: 0 30rpx; /* 两边留出距离，不要紧贴缺口 */
border: none; /* 移除旧的 border 样式 */
background-image: linear-gradient(to right, #D7CCC8 50%, transparent 50%);
background-size: 24rpx 2px; 
background-repeat: repeat-x;}

/* --- [C] 票根手记区 (Stub) --- */
.card-stub {
  background: #F7F5F0; /* 微深一点的米灰 */
  padding: 40rpx 40rpx 20rpx 40rpx;
  border-radius: 0 0 24rpx 24rpx;
  position: relative;
}

/* 贴纸墙 */
.sticker-row { display: flex; justify-content: center; gap: 20rpx; margin-bottom: 40rpx; }
.sticker { font-size: 22rpx; padding: 12rpx 24rpx; border-radius: 6rpx; font-weight: bold; box-shadow: 2rpx 4rpx 8rpx rgba(0,0,0,0.1); }
.style-core { background: #2C2C2C; color: #FFF; transform: rotate(-2deg); }
.style-trait { background: #FFF; color: #333; border: 1px solid #333; transform: rotate(1.5deg); }
.style-egg { background: #FFF9E6; color: #8D6E63; border: 1px dashed #8D6E63; transform: rotate(-1deg); }

/* 金句 */
.note-box { text-align: center; margin-bottom: 40rpx; padding: 0 20rpx; }
.note-text {
  font-family: "Kaiti SC", serif; font-size: 30rpx; color: #5D4037; line-height: 1.8;
  position: relative; display: inline-block;
}
.note-text::before { content: '""'; font-family: serif; font-size: 80rpx; color: #DDD; position: absolute; top: -30rpx; left: -40rpx; }
.note-text::after { content: '""'; font-family: serif; font-size: 80rpx; color: #DDD; position: absolute; bottom: -60rpx; right: -40rpx; line-height: 0; }

/* 签名 */
.signature-box { text-align: right; border-top: 1px solid #EAEAEA; padding-top: 20rpx; width: 100%; }
.sig-name { font-family: cursive; font-size: 28rpx; color: #333; display: block; }
.sig-date { font-size: 20rpx; color: #999; letter-spacing: 2rpx; display: block; margin-top: 6rpx;}

/* 底部锯齿 */
.zigzag-bottom {
  position: absolute; bottom: 0; left: 0; width: 100%; height: 20rpx;
  background: linear-gradient(-45deg, transparent 16rpx, #F7F5F0 0),
              linear-gradient(45deg, transparent 16rpx, #F7F5F0 0);
  background-size: 32rpx 32rpx; background-repeat: repeat-x;
  transform: translateY(18rpx) rotate(180deg);
}

/* === 动画层：塔罗牌飞行 (Flying Card) === */
.tarot-layer {
  position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
  pointer-events: none; z-index: 100;
  display: flex; align-items: center; justify-content: center;
}
.flipper {
  width: 450rpx; height: 675rpx; position: relative;
  transform-style: preserve-3d;
  transition: transform 1.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.flipper.flipped { transform: rotateY(180deg); }

/* 飞行模式 */
.tarot-layer.fly-mode .flipper {
  animation: flyToCorner 1.6s cubic-bezier(0.68, -0.2, 0.27, 1.1) forwards;
  animation-delay: 1.4s; /* 翻转后稍作停顿 */
}

/* ✈️ 核心动画：中心 -> 右上角 */
@keyframes flyToCorner {
  0% { transform: rotateY(180deg) scale(1) translate(0, 0); }
  100% {
    /* 最终态：缩小、旋转、重阴影、定位到右上角 */
    /* 注意：位移值是相对于屏幕中心的估算，适配大多数手机 */
    width: 240rpx; height: 360rpx;
    transform: rotateY(180deg) rotateZ(5deg) translate(-220rpx, -520rpx);
    box-shadow: -10rpx 10rpx 30rpx rgba(0,0,0,0.15);
  }
}

.face {
  position: absolute; width: 100%; height: 100%;
  backface-visibility: hidden; border-radius: 20rpx; overflow: hidden;
  box-shadow: 0 30rpx 60rpx rgba(0,0,0,0.3);
}
.front { transform: rotateY(180deg); background: #FFF; border: 4rpx solid #FFF; outline: 1px solid rgba(255,215,0,0.3); }
.back { background: #1a1a2e; border: 4rpx solid #D4AF37; display: flex; align-items: center; justify-content: center; color: #D4AF37; font-size: 60rpx; }
.tarot-img { width: 100%; height: 100%; }

/* 按钮区 */
.action-bar {
  width: 680rpx; display: flex; justify-content: space-between; gap: 30rpx; 
  margin-top: 50rpx;
  opacity: 0; transition: opacity 0.5s;
}
.action-bar.visible { opacity: 1; }
.btn-share, .btn-save { flex: 1; height: 96rpx; border-radius: 48rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: bold; }
.btn-share { background: #FFF; color: #333; box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05); }
.btn-save { background: linear-gradient(135deg, #6A4C9C, #9575CD); color: #FFF; box-shadow: 0 10rpx 20rpx rgba(106, 76, 156, 0.3); }
