/* 全局 */
page {
  background-color: #FFFDF9; /* 暖米色主调 */
  font-family: "Songti SC", serif;
  height: 100vh; overflow: hidden;
}
.page-container {
  width: 100%; height: 100%; position: relative;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding-bottom: env(safe-area-inset-bottom);
}
.bg-blur {
  position: absolute; width: 100%; height: 100%; opacity: 0.1; filter: blur(40px); z-index: 0;
}

/* === 核心卡片容器 === */
.result-card {
  width: 680rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(100, 90, 80, 0.1);
  position: relative; z-index: 10;
  overflow: hidden; /* 切掉多余的锯齿 */
  margin-bottom: 20rpx;
}

/* --- 1. 头部：杂志排版 --- */
.magazine-header {
  position: relative;
  height: 380rpx; /* 头部高度 */
  padding: 50rpx 40rpx;
  box-sizing: border-box;
  display: flex;
}

/* 左侧文字 (60%) */
.header-text-col {
  width: 60%;
  display: flex; flex-direction: column; justify-content: center;
  opacity: 0; transform: translateY(20rpx); transition: all 0.8s ease-out;
}
.header-text-col.fade-in { opacity: 1; transform: translateY(0); }

.mbti-big {
  font-family: "Didot", serif; font-size: 100rpx; font-weight: 900; line-height: 1;
  color: #6A4C9C; /* 品牌紫 */
  margin-bottom: 10rpx;
}
.role-title {
  font-size: 34rpx; font-weight: bold; color: #333; margin-bottom: 16rpx;
}
.slogan-box {
  width: 90%;
}
.slogan-text {
  font-size: 24rpx; color: #888; line-height: 1.5; font-style: italic;
}

/* 右侧：塔罗牌容器 (The Flying Card) */
.tarot-fly-container {
  position: absolute;
  z-index: 100;
  width: 240rpx; height: 360rpx; /* 最终大小 2:3 */
  /* 初始状态：屏幕中心 */
  top: 50vh; left: 50vw; margin-left: -120rpx; margin-top: -180rpx;
  transform: scale(1.8); /* 初始放大 */
  transition: all 1s cubic-bezier(0.34, 1.56, 0.64, 1);
  perspective: 1000rpx;
}

/* 状态：翻转中 (依然在中心) */
.tarot-fly-container.flipping .flipper {
  transform: rotateY(180deg);
}

/* 状态：归位 (飞到右上角) */
.tarot-fly-container.docked {
  top: 40rpx; left: auto; right: 40rpx; margin: 0;
  transform: scale(1) rotate(5deg); /* 归位大小 + 微倾斜 */
}
.tarot-fly-container.docked .flipper {
  transform: rotateY(180deg); /* 保持翻转后的正面 */
  box-shadow: -10rpx 10rpx 30rpx rgba(0,0,0,0.2); /* 悬浮投影 */
}

/* 翻转核心 */
.flipper {
  width: 100%; height: 100%; position: relative; transform-style: preserve-3d; transition: 0.8s;
  border-radius: 16rpx;
}
.front, .back {
  position: absolute; width: 100%; height: 100%; backface-visibility: hidden;
  border-radius: 16rpx; overflow: hidden;
  border: 4rpx solid #FFF;
}
.front { transform: rotateY(180deg); background: #FFF; }
.back {
  transform: rotateY(0deg);
  background: linear-gradient(135deg, #2C2C2C, #1A1A1A);
  display: flex; align-items: center; justify-content: center;
  color: #D4AF37; font-size: 60rpx; font-family: serif;
}
.tarot-img { width: 100%; height: 100%; }

/* --- 2. 中部：趋势图 --- */
.data-section {
  padding: 20rpx 50rpx;
  opacity: 0; transition: opacity 1s 0.2s;
}
.data-section.fade-in { opacity: 1; }

.gauge-row {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx;
}
.char { font-family: "Didot", serif; font-weight: bold; color: #4A3B55; font-size: 24rpx; width: 30rpx;}
.char.dim { color: #E0E0E0; font-weight: normal; }
.progress-track {
  flex: 1; height: 4rpx; background: #F5F5F5; margin: 0 20rpx; border-radius: 4rpx; position: relative;
}
.progress-bar {
  height: 100%; background: #D1C4E9; border-radius: 4rpx; position: relative;
}
.progress-bar::after {
  content:''; position: absolute; right: 0; top: -2rpx; width: 8rpx; height: 8rpx;
  background: #9575CD; border-radius: 50%;
}

/* --- 撕裂线 --- */
.tear-line-container {
  position: relative; height: 40rpx; display: flex; align-items: center;
  margin-top: 20rpx; opacity: 0; transition: opacity 1s 0.4s;
}
.tear-line-container.fade-in { opacity: 1; }
.dashed-line { flex: 1; border-bottom: 2px dashed #E0E0E0; margin: 0 10rpx; }
.half-circle {
  width: 24rpx; height: 40rpx; background-color: #FFFDF9; /* 与页面背景同色 */
  position: absolute; top: 0; z-index: 2;
}
.half-circle.left { left: 0; border-radius: 0 40rpx 40rpx 0; }
.half-circle.right { right: 0; border-radius: 40rpx 0 0 40rpx; }

/* --- 3. 底部：电影票根 --- */
.ticket-footer {
  /* 稍深的米色背景，区分上半部分 */
  background-color: #FDFBF7;
  padding: 40rpx 40rpx 60rpx 40rpx;
  position: relative;
  opacity: 0; transition: opacity 1s 0.6s;
}
.ticket-footer.fade-in { opacity: 1; }

/* 贴纸 */
.sticker-row { display: flex; justify-content: center; gap: 20rpx; margin-bottom: 40rpx; }
.sticker { font-size: 22rpx; padding: 10rpx 24rpx; border-radius: 4rpx; font-weight: bold; box-shadow: 2rpx 2rpx 5rpx rgba(0,0,0,0.1); }
.style-core { background: #333; color: #FFF; transform: rotate(-2deg); }
.style-trait { background: #FFF; color: #333; border: 2rpx solid #333; transform: rotate(1.5deg); }
.style-egg { background: #FFF9E6; color: #8D6E63; border: 2rpx dashed #8D6E63; transform: rotate(-1deg); }

/* 导演手记 */
.director-note { text-align: center; margin-bottom: 30rpx; }
.note-content {
  font-family: "Kaiti SC", serif; font-size: 28rpx; color: #5D4037; line-height: 1.8;
  display: block; margin-bottom: 20rpx;
}
.signature { display: flex; flex-direction: column; align-items: flex-end; margin-right: 20rpx; }
.sig-name { font-family: cursive; font-size: 30rpx; color: #333; }
.sig-date { font-size: 20rpx; color: #999; letter-spacing: 2rpx; }

/* 锯齿边缘 (CSS 绘图) */
.zigzag-bottom {
  position: absolute; bottom: 0; left: 0; width: 100%; height: 16rpx;
  background: radial-gradient(circle, transparent 8rpx, #FDFBF7 8rpx) repeat-x;
  background-size: 32rpx 32rpx;
  background-position: -16rpx 16rpx; /* 调整位置形成锯齿 */
  transform: rotate(180deg); /* 翻转让圆孔朝下 */
}

/* 按钮 */
.action-bar {
  width: 680rpx; display: flex; gap: 30rpx; margin-top: 20rpx;
  opacity: 0; transition: opacity 1s 1s;
}
.action-bar.fade-in { opacity: 1; }
.btn-share, .btn-save {
  flex: 1; height: 88rpx; border-radius: 44rpx;
  display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 28rpx;
}
.btn-share { background: #FFF; color: #4A3B55; border: 1px solid #E0E0E0; }
.btn-save { background: #4A3B55; color: #FFF; box-shadow: 0 10rpx 20rpx rgba(74, 59, 85, 0.3); }
