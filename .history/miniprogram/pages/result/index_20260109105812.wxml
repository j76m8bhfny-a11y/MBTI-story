<view class="page-container {{animStage}}">
  <view class="noise-overlay"></view>
  <image class="bg-blur" src="{{ui.poster.bg_image}}" mode="aspectFill"></image>

  <view class="result-card">
    
    <view class="card-header">
      <view class="header-text">
        <view class="mbti-huge">
          <text class="sparkle-icon">✨</text>
          {{ui.poster.type}}
        </view>
        <view class="role-title">{{ui.poster.title}}</view>
        <view class="slogan-box">
          <text class="slogan-text">"{{ui.poster.life_script}}"</text>
        </view>
      </view>
      <view class="header-slot-right"></view>
    </view>

    <view class="trends-section">
      <block wx:for="{{ui.trends}}" wx:key="key">
        <view class="trend-row-flex">
          
          <view class="side-char left {{item.isLeftWin ? 'winner' : 'loser'}}">
            {{item.leftChar}}
          </view>

          <view class="bar-container">
            <view class="bar-track">
              <view class="bar-fill" style="width: {{100 - item.score}}%;"></view>
              
              <view class="bar-dot" style="left: {{100 - item.score}}%;"></view>

              <view class="floating-pill {{item.pillClass}}" style="left: {{100 - item.score}}%;">
                {{item.statusText}}
              </view>
            </view>
          </view>

          <view class="side-char right {{!item.isLeftWin ? 'winner' : 'loser'}}">
            {{item.rightChar}}
          </view>

        </view>
      </block>
    </view>

    <view class="tear-line">
      <view class="notch-l"></view>
      <view class="dash-line"></view>
      <view class="notch-r"></view>
    </view>

    <view class="card-stub">
      <view class="recipe-container">
        <view class="recipe-title">✨ 你的专属灵魂配方 ✨</view>
        <view class="sticker-row">
          <block wx:for="{{stickers}}" wx:key="index">
            <view class="sticker style-{{item.type}}" style="{{item.randomStyle}}">
              {{item.text}}
            </view>
          </block>
        </view>
      </view>
      
      <view class="note-box">
        <text class="note-text">{{ui.poster.summary}}</text>
      </view>

      <view class="signature-box">
        <text class="sig-name">Signature: @Omega_AI</text>
        <text class="sig-date">Date: 2026.01.07</text>
      </view>

      <view class="zigzag-bottom"></view>
    </view>

  </view>

  <view class="tarot-layer {{animStage === 'docked' ? 'fly-mode' : ''}}">
    <view class="flipper {{isFlipped ? 'flipped' : ''}}">
      <view class="face front">
        <image class="tarot-img" src="{{ui.poster.bg_image}}" mode="aspectFill"></image>
        <view class="shine"></view>
      </view>

      <view class="face back">
        <image 
          class="card-back-img" 
          src="/images/card_back.png" 
          mode="aspectFill"
        ></image>
      </view>
    </view>
  </view>

  <view class="action-bar {{animStage === 'docked' ? 'visible' : ''}}">
    <button class="btn-share" open-type="share">分享给朋友</button>
    <view class="btn-save" bindtap="onSaveImage">保存纪念卡片</view>
  </view>
</view>