/* 容器 */
.result-container {
  position: relative;
  width: 100%;
  min-height: 100vh;
  overflow: hidden;
}

/* 背景图 */
.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 遮罩层 - 确保文字清晰 */
.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.3) 0%,
    rgba(0, 0, 0, 0.5) 50%,
    rgba(0, 0, 0, 0.7) 100%
  );
  z-index: 1;
}

/* 内容区域 */
.content {
  position: relative;
  z-index: 2;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== Header: 海报区 ===== */
.poster-section {
  text-align: center;
  margin-bottom: 60rpx;
  padding: 40rpx 20rpx;
}

.poster-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
  margin-bottom: 20rpx;
}

.poster-slogan {
  font-size: 28rpx;
  font-style: italic;
  color: #f0f0f0;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
  margin-bottom: 40rpx;
  opacity: 0.9;
}

.poster-type {
  font-size: 120rpx;
  font-weight: 900;
  color: #ffffff;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.6);
  letter-spacing: 10rpx;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #ffffff 0%, #e0e0e0 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.poster-summary {
  font-size: 28rpx;
  line-height: 1.8;
  color: #ffffff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.5);
  max-width: 600rpx;
  margin: 0 auto;
  opacity: 0.95;
}

/* ===== Body: 数据区 ===== */
.data-section {
  margin-bottom: 40rpx;
}

/* Keywords: 核心特质 */
.keywords-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 50rpx;
  padding: 0 20rpx;
}

.keyword-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.keyword-char {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
  margin-bottom: 10rpx;
}

.keyword-text {
  font-size: 24rpx;
  color: #f0f0f0;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
  text-align: center;
  max-width: 120rpx;
}

/* Gauge: 能量条 */
.gauge-section {
  padding: 0 20rpx;
}

.gauge-item {
  margin-bottom: 30rpx;
}

.gauge-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.gauge-letter {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.5);
  width: 60rpx;
}

.gauge-status {
  font-size: 26rpx;
  color: #f0f0f0;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
  flex: 1;
  text-align: right;
}

.gauge-bar-bg {
  width: 100%;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.gauge-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffd700 0%, #ffaa00 100%);
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.gauge-tag {
  font-size: 24rpx;
  color: #e0e0e0;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
  text-align: right;
}

/* ===== Footer: 贴纸墙 ===== */
.stickers-section {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
  padding: 20rpx;
  margin-top: auto;
}

.sticker-item {
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #fff9c4 0%, #fff59d 100%);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #333;
  box-shadow: 2rpx 4rpx 12rpx rgba(0, 0, 0, 0.15);
  transform: rotate(var(--rotation, 0deg));
  transition: transform 0.3s ease;
}

/* 给贴纸添加随机旋转效果 */
.sticker-item:nth-child(odd) {
  --rotation: -3deg;
}

.sticker-item:nth-child(even) {
  --rotation: 3deg;
}

.sticker-item:nth-child(3n) {
  --rotation: -2deg;
}

.sticker-item:nth-child(3n+1) {
  --rotation: 2deg;
}

/* 彩蛋贴纸样式 */
.sticker-item[data-type="egg"] {
  background: linear-gradient(135deg, #ffd700 0%, #ffb300 100%);
  font-weight: bold;
}

/* 成就贴纸样式 */
.sticker-item[data-type="achievement"] {
  background: linear-gradient(135deg, #ff8a80 0%, #ff5252 100%);
  color: #fff;
}
