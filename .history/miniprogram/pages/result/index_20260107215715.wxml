<view class="page-container {{animStage}}">
  <image class="bg-blur" src="{{ui.poster.bg_image}}" mode="aspectFill"></image>
  <view class="ambient-glow"></view>

  <view class="tarot-altar-container">
    <view class="flip-card {{isFlipped ? 'flipped' : ''}}">

      <view class="card-face front">
        <image class="tarot-img" src="{{ui.poster.bg_image}}" mode="aspectFill"></image>
        <view class="shine-effect"></view>
        <view class="watermark-overlay">{{ui.poster.type}}</view>
      </view>

      <view class="card-face back">
        <view class="card-back-pattern">
          <view class="mystic-circle"></view>
          <text class="logo-text">Ω</text>
        </view>
      </view>

    </view>
  </view>

  <view class="ticket-body">

    <view class="bridge-section">
      <view class="mbti-code">{{ui.poster.type}}</view>
      <text class="role-title">{{ui.poster.title}}</text>
      <text class="slogan-sub">{{ui.poster.life_script}}</text>
    </view>

    <view class="data-zone">
      <view class="ticket-tear-line">
        <view class="half-circle-left"></view>
        <view class="dashed-line"></view>
        <view class="half-circle-right"></view>
      </view>

      <view class="gauge-list">
        <block wx:for="{{['EI', 'SN', 'TF', 'JP']}}" wx:key="*this" wx:for-item="dimKey">
          <view class="gauge-item">
            <view class="gauge-labels">
              <text class="char-text {{ui.gauge[dimKey].score > 50 ? 'dim' : 'active'}}">{{dimKey[0]}}</text>
              <text class="status-text">{{ui.gauge[dimKey].tag}}</text>
              <text class="char-text {{ui.gauge[dimKey].score <= 50 ? 'dim' : 'active'}}">{{dimKey[1]}}</text>
            </view>
            <view class="progress-track">
              <view class="progress-fill" style="width: {{ui.gauge[dimKey].score}}%;"></view>
            </view>
          </view>
        </block>
      </view>

      <view class="sticker-area">
        <view class="sticker-item style-core">{{ui.stickers[0].text}}</view>
        <view class="sticker-item style-trait">{{ui.stickers[1].text}}</view>
        <view class="sticker-item style-egg">✨ {{ui.stickers[2].text}}</view>
      </view>
    </view>

    <view class="directors-note-container">
      <view class="note-label">DIRECTOR'S NOTE</view>
      <view class="note-text">{{ui.poster.summary}}</view>
      <view class="signature-box">
        <text class="sig-name">@Omega_AI</text>
        <text class="sig-date">2026.01.07</text>
      </view>
    </view>

    <view class="action-bar">
      <button class="btn-share" open-type="share">分享</button>
      <view class="btn-save" bindtap="onSaveImage">保存卡片</view>
    </view>
  </view>
</view>
