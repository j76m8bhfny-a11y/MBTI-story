/* 全局设定 */
page {
  background-color: #FFFDF9; /* 暖米白 */
  font-family: "Songti SC", "SimSun", serif;
  height: 100vh; overflow: hidden;
}
.page-container {
  width: 100%; height: 100%; position: relative;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  perspective: 1500rpx; /* 3D透视 */
}

/* === 聚焦遮罩层 === */
.focus-mask {
  position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8px);
  z-index: 900;
  opacity: 0; pointer-events: none;
  transition: opacity 0.5s ease;
  display: flex; align-items: flex-end; justify-content: center;
  padding-bottom: 100rpx;
}
.focus-mask.visible { opacity: 1; pointer-events: auto; }
.mask-hint { color: rgba(255,255,255,0.6); font-size: 24rpx; letter-spacing: 4rpx; }

/* 噪点 & 模糊背景 */
.noise-overlay {
  position: absolute; top:0; left:0; width:100%; height:100%;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E");
  opacity: 0.4;
  pointer-events: none;
  z-index: 100;
}
.bg-blur {
  position: absolute; top:0; left:0; width:100%; height:100%; opacity:0.1; filter:blur(50px); z-index: 0;
}

/* === 核心卡片容器 === */
.result-card {
  width: 680rpx;
  background: transparent;
  box-shadow: none;
  filter: drop-shadow(0 20rpx 60rpx rgba(106, 76, 156, 0.25));
  z-index: 10;
  position: relative;
  opacity: 0; transform: translateY(60rpx);
  transition: all 0.8s ease-out;
  overflow: visible; /* 允许锯齿溢出 */
}
/* 归位后滑入 */
.page-container.docked .result-card {
  opacity: 1; transform: translateY(0);
  transition-delay: 1.0s;
}

/* --- [A] 头部身份区 (Magazine Header) --- */
.card-header {
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 70rpx 40rpx 20rpx 40rpx;
  display: flex; flex-direction: row;
  position: relative;
}
.header-text { flex: 1.5; display: flex; flex-direction: column; }
.header-slot-right { flex: 1; /* 留给塔罗牌 */ }

.mbti-huge {
  font-family: "Didot", serif; font-size: 100rpx; font-weight: bold;
  color: #6A4C9C; line-height: 1; margin-bottom: 16rpx;
  position: relative;
}
.sparkle-icon { font-size: 40rpx; position: absolute; top: -10rpx; left: -30rpx; }
.role-title { font-size: 34rpx; font-weight: 900; color: #333; margin-bottom: 16rpx; letter-spacing: 2rpx;}
.slogan-box { width: 90%; }
.slogan-text { font-size: 24rpx; color: #666; line-height: 1.5; text-align: justify; }

/* --- [B] 动态趋势区 (Trends) --- */
.trends-section {
  background: #FFFFFF;
  padding-top: 80rpx;
  padding-bottom: 10rpx;
  padding-left: 40rpx;
  padding-right: 40rpx;
  width: 100%; box-sizing: border-box;
}

/* Flex 容器：[字] [条] [字] */
.trend-row-flex {
  display: flex;
  align-items: center; /* 垂直居中 */
  justify-content: space-between;
  margin-bottom: 20rpx; /* 行间距 */
  position: relative;
}

/* 左右字母样式 */
.side-char {
  font-family: "Didot", serif;
  width: 50rpx;        /* 固定宽度，防止抖动 */
  text-align: center;
  transition: all 0.3s;
}
.side-char.left { text-align: left; }   /* 左字靠左 */
.side-char.right { text-align: right; } /* 右字靠右 */

/* 赢家/输家样式 */
.side-char.winner { font-size: 40rpx; font-weight: 900; color: #6A4C9C; }
.side-char.loser { font-size: 32rpx; font-weight: 400; color: #E0E0E0; }

/* 中间进度条容器 */
.bar-container {
  flex: 1;              /* 自动占据剩余空间 */
  margin: 0 30rpx;      /* 给左右字母留出距离 */
  height: 6rpx;
  position: relative;   /* 作为定位基准 */
}

/* 轨道 */
.bar-track {
  width: 100%; height: 100%;
  background: #F5F5F5;
  border-radius: 6rpx;
  position: relative;
}

/* 填充条 */
.bar-fill {
  height: 100%;
  background: #D1C4E9; /* 浅紫填充 */
  border-radius: 6rpx;
  /* width 由 WXML 控制 */
}

/* 圆点 */
.bar-dot {
  position: absolute; top: 50%;
  width: 16rpx; height: 16rpx;
  background: #6A4C9C;
  border-radius: 50%;
  transform: translate(-50%, -50%); /* 居中定位 */
  box-shadow: 0 0 0 6rpx #FFF, 0 4rpx 10rpx rgba(106, 76, 156, 0.4);
  z-index: 2;
}

/* === 悬浮胶囊 (气泡) === */
.floating-pill {
  position: absolute;
  /* 改回上方显示 */
  bottom: 24rpx; 
  
  transform: translateX(-50%); 
  background: #F3E5F5;
  color: #6A4C9C;
  font-size: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  font-weight: bold;
  white-space: nowrap;
  box-shadow: 0 6rpx 12rpx rgba(106, 76, 156, 0.15);
  z-index: 5;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

/* 小三角 (指下) */
.floating-pill::after {
  content: ""; position: absolute; 
  bottom: -8rpx; /* 在胶囊下面 */
  left: 50%; transform: translateX(-50%);
  width: 0; height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid #F3E5F5; /* 上有色，指下 */
  transition: left 0.3s ease;
}

/* === 边缘防撞逻辑 (复用之前的 JS Class) === */

/* 靠左时：左对齐，不让气泡盖住左边的字母 */
.floating-pill.pos-left {
  transform: translateX(0);
  margin-left: -10rpx;
}
.floating-pill.pos-left::after {
  left: 20rpx; transform: none;
}

/* 靠右时：右对齐，不让气泡盖住右边的字母 */
.floating-pill.pos-right {
  transform: translateX(-100%);
  margin-left: 10rpx;
}
.floating-pill.pos-right::after {
  left: auto; right: 20rpx; transform: none;
}

/* --- [divider] 撕裂线 --- */
.tear-line {
  height: 48rpx; 
  width: 100%;
  position: relative;
  display: flex; align-items: center;
  z-index: 20;

  /* 背景：保持上下分层 */
  background: linear-gradient(to bottom, #FFFFFF 50%, #EFEBE4 50%);

  /* === 核心修复：蒙版分割法 === */
  
  /* 定义两个蒙版图像：左边一个洞，右边一个洞 */
  -webkit-mask-image: 
    radial-gradient(circle at left center, transparent 24rpx, black 25rpx),
    radial-gradient(circle at right center, transparent 24rpx, black 25rpx);
    
  /* 【关键点】让这两个蒙版各占一半宽度 (51%是为了防止中间有缝隙) */
  -webkit-mask-size: 51% 100%;
  
  /* 【关键点】分别定位在最左和最右，互不重叠覆盖 */
  -webkit-mask-position: left top, right top;
  
  /* 禁止重复，否则会乱 */
  -webkit-mask-repeat: no-repeat;
}
.notch-l, .notch-r {
  display: none; 
}
.notch-l { left:0; border-radius: 0 20rpx 20rpx 0; }
.notch-r { right:0; border-radius: 20rpx 0 0 20rpx; }
.dash-line { flex:1; height:4px; margin: 0 30rpx; /* 两边留出距离，不要紧贴缺口 */

background-image: linear-gradient(to right, #D7CCC8 50%, transparent 50%);
background-size: 24rpx 4px; 
background-repeat: repeat-x;}

/* --- [C] 票根手记区 (Stub) --- */
/* --- [New] 灵魂配方容器 (The Recipe Bracket) --- */
.recipe-container {
  position: relative;
  width: 92%;          /* 宽度稍微收一点，显得精致 */
  margin: 5rpx auto 20rpx auto; /* 居中，上下留白 */
  padding: 0rpx 20rpx 0rpx 20rpx; /* 内部给点呼吸空间 */
}

/* === 核心：用 CSS 画大括号 === */

/* 左括号 [ */
.recipe-container::before {
  content: "";
  position: absolute;
  top: 0; left: 0; bottom: 0;
  width: 15rpx;        /* 括号的“钩”的长度 */
  
  /* 描绘边框：左边实线 + 上下边框 */
  border-left: 4rpx solid #D7CCC8;  /* 稍微粗一点，像打印出来的 */
  border-top: 4rpx solid #D7CCC8;
  border-bottom: 4rpx solid #D7CCC8;
  
  /* 圆角处理：左上和左下圆角 */
  border-radius: 12rpx 0 0 12rpx; 
}

/* 右括号 ] */
.recipe-container::after {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0;
  width: 15rpx;        /* 括号的“钩”的长度 */
  
  /* 描绘边框：右边实线 + 上下边框 */
  border-right: 4rpx solid #D7CCC8;
  border-top: 4rpx solid #D7CCC8;
  border-bottom: 4rpx solid #D7CCC8;
  
  /* 圆角处理：右上和右下圆角 */
  border-radius: 0 12rpx 12rpx 0;
}

/* === 标题样式 === */
.recipe-title {
  text-align: center;
  font-size: 20rpx;
  font-weight: 800; /* 特粗 */
  color: #8D6E63;   /* 深咖色 */
  letter-spacing: 2rpx;
  margin-bottom: 24rpx; /* 标题和下面贴纸的距离 */
  position: relative;
  z-index: 2;
}

/* === 复用原来的贴纸样式，微调间距 === */
.sticker-row {
  display: flex; 
  justify-content: center; 
  flex-wrap: wrap; /* 允许换行 */
  gap: 16rpx;      /* 贴纸之间的间距 */
  padding: 0 10rpx; /* 防止贴纸碰到括号 */
}


/* 中间文字 */
.role-title {
  font-size: 20rpx; /* 极小字号，显精致 */
  color: #8D6E63;   /* 深咖色，比黑色更有质感 */
  letter-spacing: 6rpx; /* 字间距拉大 */
  font-weight: 700;     /* 加粗 */
  text-transform: uppercase;
}
.card-stub {
  background: #EFEBE4; /* 微深一点的米灰 */
  border-radius: 0 0 24rpx 24rpx;
  padding: 10rpx 40rpx 10rpx 40rpx;
  margin-top: 0;
  position: relative;
  overflow: visible;
}

/* 贴纸墙 */
.sticker-row { display: flex; justify-content: center; gap: 20rpx; margin-bottom: 40rpx; }
.sticker { font-size: 22rpx; padding: 12rpx 24rpx; border-radius: 6rpx; font-weight: bold; box-shadow: 2rpx 4rpx 8rpx rgba(0,0,0,0.1); }
.style-core { background: #2C2C2C; color: #FFF; transform: rotate(-2deg); }
.style-trait { background: #FFF; color: #333; border: 1px solid #333; transform: rotate(1.5deg); }
.style-egg { background: #FFF9E6; color: #8D6E63; border: 1px dashed #8D6E63; transform: rotate(-1deg); }

/* 金句 */
.note-box { text-align: left; margin-bottom: 20rpx; padding: 0 40rpx; }
.note-text {
  font-family: "Kaiti SC", serif; font-size: 25rpx; color: #62433aff; line-height: 1.8;
  position: relative; display: inline-block;
  padding-top: 35rpx;
  padding-bottom: 10rpx;
}
.note-text::before { content: '“'; font-family: serif; font-size: 80rpx; color: #DDD; position: absolute; top: -40rpx; left: -40rpx; }
.note-text::after { content: '”'; font-family: serif; font-size: 80rpx; color: #DDD; position: absolute; bottom: -40rpx; right: -40rpx; line-height: 0; }

/* 签名 */
.signature-box { text-align: right; border-top: 1px solid #EAEAEA; padding-top: 20rpx; width: 100%; }
.sig-name { font-family: cursive; font-size: 28rpx; color: #333; display: block; }
.sig-date { font-size: 20rpx; color: #999; letter-spacing: 2rpx; display: block; margin-top: 6rpx;}

/* 底部锯齿 */
.zigzag-bottom {
  position: absolute; 
  left: 0; 
  width: 100%; 
  
  /* 锯齿的大小设置 */
  height: 20rpx;        /* 锯齿的高度 */
  bottom: -20rpx;       /* 核心定位：将锯齿完全移到卡片容器的外面 */
  z-index: 99;
  
  /* 使用两个线性渐变拼接出“向下指”的三角形 */
  /* 135deg 负责左半边，225deg 负责右半边，颜色必须与 card-stub 一致 (#F7F5F0) */
  background-image: 
    linear-gradient(135deg, #EFEBE4 50%, transparent 50%),
    linear-gradient(225deg, #EFEBE4 50%, transparent 50%);
    
  /* 宽度必须是高度的2倍，才能形成标准的直角三角形 (45度角) */
  background-size: 40rpx 20rpx; 
  
  /* 确保图案从左上角开始重复 */
  background-position: top left;
  background-repeat: repeat-x;
  
  /* 移除旧代码中的 transform 和旋转，现在不需要了 */
  transform: none; 
}

/* === 动画层：塔罗牌飞行 (Flying Card) === */

.tarot-layer {
  position: fixed;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1000;
  transition: all 1.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  visibility: visible;
  pointer-events: auto;
}

/* 状态 A: Docked (右上角) */
.tarot-layer.docked {
  top: -280rpx; left: auto; right: -100rpx;
  transform: translate(0, 0) scale(0.43) rotate(5deg);
}

/* 状态 B: Focused (中心 + 放大) */
.tarot-layer.focused {
  top: 50% !important; left: 50% !important; right: auto !important;
  transform: translate(-50%, -60%) scale(1) rotate(0deg) !important;
  z-index: 2000 !important;
}

/* 悬浮包装器 - 用于呼吸动画 */
.levitate-wrapper {
  position: relative;
  transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 聚焦时的呼吸动画 */
.tarot-layer.focused .levitate-wrapper {
  animation: breathe 4s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { transform: translateY(0) rotateX(0deg); }
  50% { transform: translateY(-20rpx) rotateX(2deg); }
}

@keyframes fadeInBlur {
  0% {
    opacity: 0;
    filter: blur(20rpx);    /* 初始模糊 */
    transform: scale(0.95); /* 初始微缩，增加呼吸感 */
  }
  100% {
    opacity: 1;
    filter: blur(0);        /* 清晰 */
    transform: scale(1);    /* 复原 */
  }
}
.flipper {
  width: 600rpx; height: 900rpx; position: relative;
  margin-bottom: 140rpx;
  transform-style: preserve-3d;
  transition: transform 1.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  animation: fadeInBlur 1.0s cubic-bezier(0.23, 1, 0.32, 1);
}
.flipper.flipped { transform: rotateY(180deg); }

.face {
  position: absolute; width: 100%; height: 100%;
  backface-visibility: hidden; border-radius: 20rpx; overflow: hidden;
  box-shadow: 0 30rpx 60rpx rgba(0,0,0,0.3);
}
.front { transform: rotateY(180deg); background: #FFF; border: 4rpx solid #FFF; outline: 1px solid rgba(255,215,0,0.3); }
.back { background: #1a1a2e;border: 4rpx solid #f0d57eff; }
.card-back-img { 
  width: 100%; 
  height: 100%; 
  display: block; 
  border-radius: 16rpx; /* 稍微比外框小一点点，或者设为 inherit */
}
.tarot-img { width: 100%; height: 100%; }

/* === QR 码存根样式 === */
.qr-stub {
  position: absolute; top: 98%; left: 5%; width: 90%;
  background-color: #EFEBE4;
  border-radius: 0 0 0rpx 0rpx;
  padding: 30rpx 20rpx 40rpx 20rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 40rpx rgba(0,0,0,0.2);
  opacity: 0; transform: translateY(-20rpx);
  transition: all 0.5s ease 0.2s;
  z-index: -1;
}
.tarot-layer.focused .qr-stub {
  opacity: 1; transform: translateY(0);
}

.stub-content {
  display: flex; align-items: center; gap: 20rpx;
}

.qr-placeholder {
  width: 80rpx; height: 80rpx;
  background: #FFF;
  border-radius: 8rpx;
  display: flex; align-items: center; justify-content: center;
  border: 2rpx solid #D7CCC8;
}

.qr-dot {
  width: 40rpx; height: 40rpx;
  background: #6A4C9C;
  border-radius: 4rpx;
  position: relative;
}

.qr-dot::before, .qr-dot::after {
  content: ''; position: absolute;
  background: #6A4C9C;
}

.qr-dot::before {
  width: 12rpx; height: 12rpx;
  top: 4rpx; left: 4rpx;
}

.qr-dot::after {
  width: 12rpx; height: 12rpx;
  bottom: 4rpx; right: 4rpx;
}

.stub-text {
  flex: 1; display: flex; flex-direction: column; gap: 8rpx;
}

.scan-hint {
  font-size: 22rpx; color: #6A4C9C; font-weight: bold;
}

.copyright {
  font-size: 18rpx; color: #999;
}

.stub-zigzag {
  position: absolute; bottom: -20rpx; left: 0; width: 100%; height: 20rpx;
  background-image:
    linear-gradient(135deg, #EFEBE4 50%, transparent 50%),
    linear-gradient(225deg, #EFEBE4 50%, transparent 50%);
  background-size: 40rpx 20rpx;
  background-repeat: repeat-x;
}

/* 按钮区 */
.action-bar {
  width: 680rpx; display: flex; justify-content: space-between; gap: 30rpx;
  margin-top: 50rpx;
  opacity: 0; transition: opacity 0.5s;
  position: relative;
  z-index: 999;
}
.action-bar.visible { opacity: 1; }
.btn-share, .btn-save { flex: 1; height: 96rpx; border-radius: 48rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: bold; position: relative; overflow: hidden; }
.btn-share { background: #FFF; color: #333; box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05); }
.btn-save { background: linear-gradient(135deg, #6A4C9C, #9575CD); color: #FFF; box-shadow: 0 10rpx 20rpx rgba(106, 76, 156, 0.3); }

/* 按钮闪光动画 */
.btn-save::after {
  content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  animation: shine-btn 3s infinite;
}
@keyframes shine-btn {
  0% { left: -100%; } 20% { left: 100%; } 100% { left: 100%; }
}

/* 粒子容器：居中定位 */
.magic-particles {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  
  pointer-events: none;
}

/* 单个粒子基础样式 */
.particle {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background-color: #FFD700; /* 金色 */
  border-radius: 50%;
  box-shadow: 0 0 15rpx #FFD700, 0 0 30rpx #FFA500; /* 发光效果 */
  opacity: 0;
}

/* 粒子动画：向四周炸开并消失 */
@keyframes particle-explode {
  0% {
    transform: translate(0, 0) scale(1);
    opacity: 1;
  }
  100% {
    /* 这里的变量会在下面的 nth-child 里被重新定义，形成扩散 */
    transform: translate(var(--tx), var(--ty)) scale(0);
    opacity: 0;
  }
}

/* 给这12个粒子分配不同的方向和距离 */
.particle:nth-child(1)  { --tx: -280rpx; --ty: -280rpx; animation: particle-explode 1.2s ease-out forwards; }
.particle:nth-child(2)  { --tx: 0rpx;    --ty: -380rpx; animation: particle-explode 1.2s ease-out 0.1s forwards; }
.particle:nth-child(3)  { --tx: 280rpx;  --ty: -280rpx; animation: particle-explode 1.2s ease-out 0.2s forwards; }
.particle:nth-child(4)  { --tx: 380rpx;  --ty: 0rpx;    animation: particle-explode 1.2s ease-out forwards; }
.particle:nth-child(5)  { --tx: 280rpx;  --ty: 280rpx;  animation: particle-explode 1.2s ease-out 0.1s forwards; }
.particle:nth-child(6)  { --tx: 0rpx;    --ty: 380rpx;  animation: particle-explode 1.2s ease-out 0.3s forwards; }
.particle:nth-child(7)  { --tx: -280rpx; --ty: 280rpx;  animation: particle-explode 1.2s ease-out forwards; }
.particle:nth-child(8)  { --tx: -380rpx; --ty: 0rpx;    animation: particle-explode 1.2s ease-out 0.2s forwards; }
.particle:nth-child(9)  { --tx: -180rpx;  --ty: -300rpx; animation: particle-explode 1.5s ease-out 0.1s forwards; }
.particle:nth-child(10) { --tx: 180rpx;   --ty: -300rpx; animation: particle-explode 1.5s ease-out 0.2s forwards; }
.particle:nth-child(11) { --tx: 180rpx;   --ty: 300rpx;  animation: particle-explode 1.5s ease-out forwards; }
