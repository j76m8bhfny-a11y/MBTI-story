/* 确保页面容器占满屏幕 */
.test-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background-color: #F5F7FA; /* 增加一个极其淡的背景色，衬托白卡片 */
}

/* 分段式进度条 */
.progress-header {
  width: 100%;
  padding: 20rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  background: transparent;
  z-index: 20; /* 确保进度条在图片之上 */
}

.progress-track {
  position: relative;
  width: 100%;
  height: 8rpx; /* 稍微细一点更精致 */
  background: rgba(0, 0, 0, 0.1); /* 在图片上显示时用半透明黑 */
  border-radius: 999px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFB7B2, #BFA6D9);
  border-radius: 999px;
  transition: width 0.3s ease;
}

/* 阶段分割点 */
.stage-marker {
  position: absolute;
  top: 0;
  width: 2rpx;
  height: 100%;
  background: rgba(255, 255, 255, 0.6);
  z-index: 2;
}

.stage-text {
  font-size: 22rpx;
  color: #666; /* 如果背景是浅色 */
  /* color: rgba(255,255,255,0.9); 如果进度条盖在深色图片上 */
  text-align: right;
  font-family: monospace;
  font-weight: 500;
}

/* 核心卡片容器 */
.card-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin: 10rpx 30rpx 30rpx 30rpx; /* 调整边距 */
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.08); /* 更柔和的高级投影 */
  overflow: hidden;
  position: relative;
}

/* --- 插画区 (Header Image) --- */
.illustration-area {
  width: 100%;
  height: 480rpx; /* ⚠️ 修改点：高度从 320rpx 增加到 480rpx，展示更多画面 */
  position: relative;
  background-color: #F0F2F5;
}

.illustration {
  width: 100%;
  height: 100%;
  object-fit: cover; /* 关键：裁剪 */
  display: block;
}

/* 场景标签 (新增) */
.scenario-tag {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  padding: 8rpx 24rpx;
  border-radius: 99px;
  font-size: 22rpx;
  font-weight: 500;
  backdrop-filter: blur(8px);
  z-index: 5;
  letter-spacing: 1rpx;
}

/* --- 内容区域 (叠层) --- */
.content-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  
  margin-top: -40rpx; /* 向上重叠 */
  border-radius: 40rpx 40rpx 0 0;
  background: #fff;
  position: relative;
  z-index: 10;
  
  padding: 50rpx 40rpx 30rpx 40rpx; /* 顶部 padding 加大，因为圆角占空间 */
}

/* 题目文本 */
.question-text {
  height: 240rpx; /* 固定高度 */
  font-size: 34rpx;
  line-height: 1.6;
  color: #2c3e50;
  font-weight: 600;
  text-align: left; /* 改为左对齐 */
  
  display: flex;
  align-items: center; /* 垂直居中 */
  justify-content: flex-start;
  
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
  margin-bottom: 20rpx;
}

/* === 双层卡片 & 交互部分 === */
.answer-layout-wrapper {
  position: relative;
  width: 100%;
  height: 200rpx; /* 稍微调低一点，配合整体布局 */
  margin-bottom: 20rpx;
}

.card-layer {
  position: absolute;
  top: 0;
  left: 20rpx;
  right: 20rpx;
  bottom: 0; /* 左右留点空隙 */
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 1. 底层垫片 (制造凹槽感) */
.background-card {
  /* 颜色稍微加深一点，偏冷灰 */
  background-color: #EDF1F7;
  z-index: 1;
  /* 增加一个微妙的内阴影，让它看起来是凹陷下去的 */
  box-shadow: inset 0 4rpx 12rpx rgba(0,0,0,0.05);
  /* 保持原有的缩放和位置 */
  transform: scale(0.95) translateY(10rpx);
  transform-origin: 50% 100%;
}

/* 2. 顶层操作卡 (制造悬浮感) */
.active-card {
  /* 改为纯白，更干净，对比度更高 */
  background-color: #FFFFFF;
  z-index: 10;
  /* ⚠️ 核心升级：使用更柔和、扩散的双层投影，制造高级悬浮感 */
  box-shadow:
    0 12rpx 28rpx -6rpx rgba(0, 0, 0, 0.08),
    0 4rpx 10rpx -4rpx rgba(0, 0, 0, 0.04);
  
  /* 增加极细微的边框界定边界 */
  border: 1rpx solid rgba(0,0,0,0.03);
  transform-origin: 50% 120%;
  will-change: transform;
  transition: transform 0.1s, background-color 0.2s, box-shadow 0.2s, border-color 0.2s;
}

/* 3. 物理按压态 */
.card-hover {
  transform: scale(0.98) !important;
  background-color: #FAFCFF !important;
}

/* 4. 选中高亮态 (光晕效果) */
.selected-mode {
  /* 使用非常淡的渐变蓝背景 */
  background: linear-gradient(135deg, #F5F9FF 0%, #ECF3FF 100%) !important;
  /* 边框色更柔和 */
  border-color: #8FB5F9 !important;
  transform: scale(0.96) !important;
  /* ⚠️ 核心升级：改为蓝色的扩散光晕，而不是黑色投影 */
  box-shadow: 0 8rpx 24rpx rgba(91, 143, 249, 0.25) !important;
}

.card-content {
  width: 100%;
  height: 100%;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.common-card-text {
  width: 100%;
  white-space: normal;
  word-break: break-word;
  text-align: center;
  font-size: 34rpx;
  line-height: 1.4;
  color: #333;
  font-weight: 600;
  max-height: 100%;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.background-card .common-card-text {
  opacity: 0.4;
}

.tap-hint {
  position: absolute;
  bottom: 16rpx;
  left: 0;
  width: 100%;
  text-align: center;
  font-size: 20rpx;
  color: #BFA6D9;
  opacity: 0.7;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.hint-arrow {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #BFA6D9;
  font-size: 48rpx;
  opacity: 0.5;
}

.hint-arrow.left { left: 0; animation: bounceLeft 1.5s infinite; }
.hint-arrow.right { right: 0; animation: bounceRight 1.5s infinite; }
.hint-arrow.faded, .tap-hint.faded { opacity: 0 !important; animation: none; }

@keyframes bounceLeft {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(-6rpx); }
}

@keyframes bounceRight {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(6rpx); }
}

.ruler-wrapper {
  width: 100%;
  margin-top: auto;
}

/* 底部导航 */
.footer-actions {
  position: absolute;
  bottom: calc(30rpx + env(safe-area-inset-bottom));
  left: 0;
  width: 100%;
  padding: 0 50rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
  pointer-events: none; /* 让中间区域穿透 */
}

.text-action {
  font-size: 28rpx;
  padding: 20rpx;
  pointer-events: auto;
  transition: opacity 0.2s;
  display: flex;
  align-items: center;
}

.secondary { color: #999; }
.primary-text { color: #333; font-weight: 600; }
.text-hover { opacity: 0.6; }
.spacer { width: 1px; }
