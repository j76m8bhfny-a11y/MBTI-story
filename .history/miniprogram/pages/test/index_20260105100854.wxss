.test-container {
  min-height: 100vh;
  background: var(--bg-color);
  display: flex;
  flex-direction: column;
  padding-bottom: 120rpx;
}

/* 顶部标题 */
.header {
  padding: 40rpx 0 20rpx;
  text-align: center;
}

.title {
  font-family: 'Times New Roman', serif;
  font-size: 28rpx;
  color: var(--text-title);
  font-weight: 600;
}

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 4rpx;
  background: var(--progress-bg);
  border-radius: 999px;
  overflow: hidden;
  margin: 0 40rpx 16rpx;
}

.progress-fill {
  height: 100%;
  background: var(--progress-active);
  border-radius: 999px;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: var(--text-sub-color);
  text-align: center;
  margin-bottom: 40rpx;
}

/* 核心卡片 */
.card-container {
  margin: 0 40rpx;
  background: var(--card-bg);
  border-radius: 40rpx;
  box-shadow: var(--card-shadow);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
}

/* 插画区 */
.illustration-area {
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.illustration {
  width: 100%;
  height: 100%;
}

/* 标签 */
.tag {
  display: inline-block;
  background: #f0f0f0;
  color: #999;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  border-radius: 99px;
  margin-bottom: 24rpx;
  align-self: flex-start;
}

/* 题目 */
.question-text {
  font-size: 34rpx;
  line-height: 1.8;
  color: var(--text-body);
  text-align: left;
  margin-bottom: 40rpx;
}

/* 动态答案展示区 */
.answer-display {
  min-height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  padding: 20rpx 0;
}

.emoji-feedback {
  font-size: 60rpx;
  margin-bottom: 16rpx;
  animation: bounce 0.3s ease;
}

.answer-text {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-title);
  text-align: center;
  line-height: 1.5;
}

@keyframes bounce {
  0% {
    transform: scale(0.8);
    opacity: 0;
  }
  50% {
    transform: scale(1.1);
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 刻度尺包装器 */
.ruler-wrapper {
  margin-top: 20rpx;
}

/* 底部按钮 */
.button-wrapper {
  position: fixed;
  bottom: 50rpx;
  left: 40rpx;
  right: 40rpx;
}

.next-button {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  color: #fff;
  background: linear-gradient(to right, #FFB7B2, #BFA6D9);
  border: none;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(191, 166, 217, 0.4);
  transition: all 0.3s ease;
}

.next-button::after {
  border: none;
}

.next-button[disabled] {
  opacity: 0.4;
  background: #ccc;
  box-shadow: none;
}

.next-button:not([disabled]):active {
  transform: scale(0.98);
  box-shadow: 0 4px 12px rgba(191, 166, 217, 0.3);
}
