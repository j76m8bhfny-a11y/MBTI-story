<view class="test-container">
  <!-- 分段式进度条 -->
  <view class="progress-header">
    <view class="progress-track">
      <view class="progress-fill" style="width: {{ (currentIndex + 1) / 60 * 100 }}%"></view>
      
      <view class="stage-marker" style="left: 16.66%"></view>
      <view class="stage-marker" style="left: 33.33%"></view>
      <view class="stage-marker" style="left: 50%"></view>
      <view class="stage-marker" style="left: 66.66%"></view>
      <view class="stage-marker" style="left: 83.33%"></view>
    </view>
    
    <view class="stage-text">
      进度 {{currentIndex + 1}} / 60
    </view>
  </view>
 
  <!-- 核心卡片 -->
  <view class="card-container">
    <!-- 插画区 -->
    <view class="illustration-area">
      <image
        class="illustration"
        src="{{currentQuestion.img || '/assets/images/fallback.svg'}}"
        mode="aspectFill"
      />
    </view>
 
    <!-- 内容区域 -->
    <view class="content-area">
      <!-- 题目 -->
      <view class="question-text scenario-text">{{currentQuestion.txt}}</view> 
      <!-- 双层卡片堆叠 -->
      <view class="answer-layout-wrapper">
        
        <!-- 底层垫片卡 -->
        <view class="card-layer background-card" style="{{backgroundTransform}}">
          <view class="card-content">
            <text class="common-card-text">{{previewText}}</text>
          </view>
        </view>

        <!-- 顶层交互卡 -->
        <view class="card-layer active-card {{isCardSelected ? 'selected-mode' : ''}}"
          bindtap="onCardTap"
          hover-class="card-hover"
          hover-stay-time="100"
          style="{{cardTransform}}; {{cardTransition}}"
          bindtouchstart="onCardTouchStart"
          bindtouchmove="onCardTouchMove"
          bindtouchend="onCardTouchEnd"
        >
          <view class="hint-arrow left {{hasMoved ? 'faded' : ''}}">‹</view>
          <view class="hint-arrow right {{hasMoved ? 'faded' : ''}}">›</view>
          
          <view class="card-content">
            <text class="common-card-text">{{currentQuestion.opts[currentRulerIndex]}}</text>
            
            <text class="tap-hint {{hasMoved ? 'faded' : ''}}">点击确认</text>
          </view>
        </view>

      </view>
 
      <!-- 刻度尺组件 -->
      <view class="ruler-wrapper">
        <ruler-slider
          value="{{rulerValue}}"
          options="{{currentQuestion.opts}}"
          bind:change="onRulerChange"
          bind:changing="onRulerChanging"
        />
      </view>
    </view>
  </view>

  <!-- 底部极简导航 -->
  <view class="footer-actions">
    <view class="text-action secondary" 
      wx:if="{{currentIndex > 0}}" 
      catchtap="onPrevTap"
      hover-class="text-hover"
    >
      <text>↩︎ 上一题</text>
    </view>
    <view wx:else class="spacer"></view>

    <view class="text-action primary-text" 
      catchtap="onNextTap"
      hover-class="text-hover"
    >
      下一题 ➝
    </view>
  </view>
</view>
