/* 确保页面容器占满屏幕 */
.test-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom)); /* 给底部按钮留位 */
  overflow: hidden; /* 禁止滚动 */
}

/* 分段式进度条 */
.progress-header {
  width: 100%;
  padding: 20rpx 40rpx; /* 左右留白 */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  background: transparent;
}

.progress-track {
  position: relative;
  width: 100%;
  height: 12rpx; /* 细条 */
  background: #E0E0E0; /* 未完成颜色：浅灰 */
  border-radius: 999px;
  overflow: hidden; /* 裁剪圆角 */
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFB7B2, #BFA6D9); /* 莫兰迪渐变色 */
  border-radius: 999px;
  transition: width 0.3s ease; /* 丝滑动画 */
}

/* 阶段分割点 (小白点) */
.stage-marker {
  position: absolute;
  top: 0;
  width: 4rpx; /* 极细分割线 */
  height: 100%;
  background: rgba(255, 255, 255, 0.8); /* 半透明白 */
  z-index: 2;
  /* 使得分割线不遮挡圆角，视觉上是断开的 */
}

.stage-text {
  font-size: 24rpx;
  color: #999;
  text-align: right; /* 右对齐 */
  font-family: monospace; /* 等宽字体数字对齐 */
}

/* 核心卡片 */
.card-container {
  /* 弹性生长：占满除去进度条和按钮之外的所有空间 */
  flex: 1;
  
  display: flex;
  flex-direction: column;
  
  /* 样式保持 */
  margin: 20rpx 40rpx 40rpx 40rpx; /* 上下左右留白 */
  background: #fff;
  border-radius: 40rpx;
  box-shadow: var(--card-shadow);
  padding: 0; /* 清除 Padding，改为内部控制 */
  overflow: hidden;
}

/* 插画区 */
.illustration-area {
  width: 100%;
  /* 核心：让图片占据卡片上半部分的大量空间 */
  height: 45%;
  background-color: #F9F9F9; /* 图片加载前的占位色 */
  position: relative;
}

.illustration {
  width: 100%;
  height: 100%;
  object-fit: cover; /* 充满区域 */
}

/* 内容区域均匀分布 */
.content-area {
  flex: 1; /* 占据卡片剩余高度 (55%) */
  display: flex;
  flex-direction: column;
  justify-content: space-between; /* 关键：上下撑开，均匀分布 */
  padding: 30rpx 30rpx 40rpx 30rpx;
}

/* 题目文本 */
.question-text {
  font-size: 34rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

/* 答案展示区 (带底色的) */
.answer-display-area {
  position: relative; /* 为箭头定位 */
  /* 也可以给它一点弹性 */
  flex-grow: 1;
  /* 保持之前的样式 */
  background-color: #F7F9FC;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 30rpx;
  /* 限制最大高度，防止在大屏手机上太高 */
  max-height: 180rpx;
}

.answer-text {
  flex: 1;
  text-align: center;
  padding: 0 40rpx; /* 防止文字盖住箭头 */
  z-index: 1;
}

/* 箭头容器 */
.hint-arrow {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #BFA6D9; /* 主题紫 */
  font-size: 60rpx;
  font-weight: 300;
  opacity: 0.6;
  transition: opacity 0.5s;
}

.hint-arrow.left { left: 0; animation: bounceLeft 1.5s infinite; }
.hint-arrow.right { right: 0; animation: bounceRight 1.5s infinite; }

/* 用户一旦操作过，箭头就淡出，减少打扰 */
.hint-arrow.faded {
  opacity: 0 !important;
  animation: none;
}

/* 定义呼吸动画 */
@keyframes bounceLeft {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(-10rpx); }
}

@keyframes bounceRight {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(10rpx); }
}

/* 刻度尺容器 */
.ruler-wrapper {
  /* 移除 absolute 定位，改为 Flex 流内布局 */
  /* 因为 justify-content: space-between 已经把它推到底部了 */
  width: 100%;
  margin-top: auto; /* 双重保险：推到底部 */
}

/* 底部按钮 */
.button-wrapper {
  position: fixed;
  bottom: 50rpx;
  left: 40rpx;
  right: 40rpx;
}

.next-button {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  color: #fff;
  background: linear-gradient(to right, #FFB7B2, #BFA6D9);
  border: none;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(191, 166, 217, 0.4);
  transition: all 0.3s ease;
}

.next-button::after {
  border: none;
}

.next-button[disabled] {
  opacity: 0.4;
  background: #ccc;
  box-shadow: none;
}

.next-button:not([disabled]):active {
  transform: scale(0.98);
  box-shadow: 0 4px 12px rgba(191, 166, 217, 0.3);
}
