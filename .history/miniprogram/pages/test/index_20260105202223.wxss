/* 确保页面容器占满屏幕 */
.test-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom)); /* 给底部按钮留位 */
  overflow: hidden; /* 禁止滚动 */
}

/* 分段式进度条 */
.progress-header {
  width: 100%;
  padding: 20rpx 40rpx; /* 左右留白 */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  background: transparent;
}

.progress-track {
  position: relative;
  width: 100%;
  height: 12rpx; /* 细条 */
  background: #E0E0E0; /* 未完成颜色：浅灰 */
  border-radius: 999px;
  overflow: hidden; /* 裁剪圆角 */
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFB7B2, #BFA6D9); /* 莫兰迪渐变色 */
  border-radius: 999px;
  transition: width 0.3s ease; /* 丝滑动画 */
}

/* 阶段分割点 (小白点) */
.stage-marker {
  position: absolute;
  top: 0;
  width: 4rpx; /* 极细分割线 */
  height: 100%;
  background: rgba(255, 255, 255, 0.8); /* 半透明白 */
  z-index: 2;
  /* 使得分割线不遮挡圆角，视觉上是断开的 */
}

.stage-text {
  font-size: 24rpx;
  color: #999;
  text-align: right; /* 右对齐 */
  font-family: monospace; /* 等宽字体数字对齐 */
}

/* 核心卡片 */
.card-container {
  /* 弹性生长：占满除去进度条和按钮之外的所有空间 */
  flex: 1;
  
  display: flex;
  flex-direction: column;
  
  /* 样式保持 */
  margin: 20rpx 40rpx 40rpx 40rpx; /* 上下左右留白 */
  background: #fff;
  border-radius: 40rpx;
  box-shadow: var(--card-shadow);
  padding: 0; /* 清除 Padding，改为内部控制 */
  overflow: hidden;
}

/* 插画区 */
.illustration-area {
  width: 100%;
  /* 核心：让图片占据卡片上半部分的大量空间 */
  height: 45%;
  background-color: #F9F9F9; /* 图片加载前的占位色 */
  position: relative;
}

.illustration {
  width: 100%;
  height: 100%;
  object-fit: cover; /* 充满区域 */
}

/* 内容区域均匀分布 */
.content-area {
  flex: 1; /* 占据卡片剩余高度 (55%) */
  display: flex;
  flex-direction: column;
  justify-content: space-between; /* 关键：上下撑开，均匀分布 */
  padding: 30rpx 30rpx 40rpx 30rpx;
}

/* 题目文本 */
.question-text {
  font-size: 34rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

/* ==================== 双层卡片堆叠样式 ==================== */

/* 容器：占据文档流空间 */
.answer-layout-wrapper {
  position: relative;
  width: 100%;
  height: 240rpx;
  margin-bottom: 40rpx;
}

/* 卡片通用层 */
.card-layer {
  position: absolute;
  top: 0; 
  left: 40rpx; 
  right: 40rpx; 
  bottom: 0;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 底层垫片 */
.background-card {
  background-color: #F0F2F5;
  z-index: 1;
  /* 默认状态：稍微缩小，制造堆叠的厚度感 */
  transform: scale(0.95) translateY(10rpx);
  transform-origin: 50% 100%; /* 底部对齐缩放 */
}

/* 顶层卡片 */
.active-card {
  background-color: #F7F9FC; /* 明亮色 */
  z-index: 10;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.1); /* 悬浮投影 */
  transform-origin: 50% 120%; /* 旋转轴心在手握处 */
  will-change: transform;
  transition: transform 0.1s, background-color 0.2s;
  border: 4rpx solid transparent; /* 预留边框空间，防止抖动 */
}

/* 物理按压效果 (代替复杂的 JS 动画，用 CSS 原生实现更流畅) */
.card-hover {
  transform: scale(0.98) !important;
  background-color: #FAFCFF !important;
}

/* 选中高亮态 - 强烈的视觉反馈 */
.selected-mode {
  background-color: #E6EFFF !important; /* 明显的淡蓝色 */
  border: 4rpx solid #5B8FF9 !important; /* 明显的边框 */
  transform: scale(0.96) !important;      /* 明显的按压 */
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1) !important; /* 增强阴影 */
  transition: all 0.1s ease-in-out !important; /* 瞬间响应 */
}

/* --- 内容容器 --- */
.card-content {
  width: 100%;
  height: 100%;
  padding: 0 40rpx; /* ⚠️ 关键：左右留白，防止文字贴边 */
  box-sizing: border-box;
  
  /* Flex 居中布局 */
  display: flex;
  align-items: center;     /* 垂直居中 */
  justify-content: center; /* 水平居中 */
  overflow: hidden;        /* 防止极端情况溢出 */
}

/* --- 文字样式 --- */
.common-card-text {
  width: 100%;
  /* ⚠️ 核心修复：允许换行 */
  white-space: normal; 
  word-break: break-word; 
  text-align: center;
  
  /* 样式调整 */
  font-size: 36rpx;
  line-height: 1.5;
  color: #333;
  font-weight: 600;
  
  /* 移除 height: 100%，让高度由文字内容撑开 */
  max-height: 100%; /* 防止超出父容器 */
  display: -webkit-box; /* 多行截断 (可选，防止万一太长) */
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4; /* 最多显示4行，超过显示省略号 */
  overflow: hidden;
}

/* 针对底层预览文字的特殊处理 (仅透明度不同) */
.background-card .common-card-text {
  opacity: 0.5;      /* 预览时稍微淡一点 */
  color: #333;       /* 颜色基调保持一致 */
}

/* 引导提示文字 */
.tap-hint {
  display: block;
  font-size: 20rpx;
  color: #BFA6D9; /* 主题色 */
  letter-spacing: 2rpx;
  opacity: 0.6;
  text-transform: uppercase;
  position: absolute; /* 绝对定位，不干扰 Flex 居中 */
  bottom: 20rpx;
  left: 0;
  width: 100%;
  text-align: center;
}

/* 箭头容器 */
.hint-arrow {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #BFA6D9; /* 主题紫 */
  font-size: 60rpx;
  font-weight: 300;
  opacity: 0.6;
  transition: opacity 0.5s;
}

.hint-arrow.left { left: 0; animation: bounceLeft 1.5s infinite; }
.hint-arrow.right { right: 0; animation: bounceRight 1.5s infinite; }

/* 用户一旦操作过，箭头就淡出，减少打扰 */
.hint-arrow.faded {
  opacity: 0 !important;
  animation: none;
}

.tap-hint.faded {
  opacity: 0 !important;
}

/* 定义呼吸动画 */
@keyframes bounceLeft {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(-10rpx); }
}

@keyframes bounceRight {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(10rpx); }
}

/* 刻度尺容器 */
.ruler-wrapper {
  /* 移除 absolute 定位，改为 Flex 流内布局 */
  /* 因为 justify-content: space-between 已经把它推到底部了 */
  width: 100%;
  margin-top: auto; /* 双重保险：推到底部 */
}

/* ==================== 底部极简导航 ==================== */
.footer-actions {
  position: absolute;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  left: 0;
  width: 100%;
  padding: 0 60rpx; /* 更宽的边距 */
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
  pointer-events: box-none;
}

.text-action {
  font-size: 28rpx;
  padding: 20rpx;
  pointer-events: auto;
  transition: opacity 0.2s;
}

.secondary {
  color: #999; /* 灰色，不抢眼 */
}

.primary-text {
  color: #333; /* 深色，稍微显眼一点点 */
  font-weight: 500;
}

.text-hover {
  opacity: 0.5;
}

.spacer {
  width: 1px;
}
