/* 全局容器锁定 */
page {
  height: 100%;
  overflow: hidden; /* ⛔️ 禁止页面级滚动 */
}

/* --- 转场遮罩 --- */
.scene-curtain {
  position: fixed;
  top: 0; left: 0;
  width: 100vw;
  height: 100vh;
  
  /* 与 transition 页背景一致 */
  background-color: #FFFDF5;
  
  z-index: 9999;
  opacity: 1;
  pointer-events: all;
  
  /* 保持快速过渡 (0.3s) */
  transition: opacity 0.3s ease-out, visibility 0.3s step-end;
}

/* 淡出状态 */
.scene-curtain.fade-out {
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
}

/* 确保页面容器占满屏幕 */
.test-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  overflow: hidden; /* ⛔️ 禁止容器级滚动 */
  background-color: #F5F7FA; /* 增加一个极其淡的背景色，衬托白卡片 */
}

/* 分段式进度条 */
.progress-header {
  width: 100%;
  padding: 20rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  background: transparent;
  z-index: 20; /* 确保进度条在图片之上 */
}

.progress-track {
  position: relative;
  width: 100%;
  height: 8rpx; /* 稍微细一点更精致 */
  background: rgba(0, 0, 0, 0.1); /* 在图片上显示时用半透明黑 */
  border-radius: 999px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFB7B2, #BFA6D9);
  border-radius: 999px;
  transition: width 0.3s ease;
}

/* 阶段分割点 */
.stage-marker {
  position: absolute;
  top: 0;
  width: 2rpx;
  height: 100%;
  background: rgba(255, 255, 255, 0.6);
  z-index: 2;
}

.stage-text {
  font-size: 22rpx;
  color: #666; /* 如果背景是浅色 */
  /* color: rgba(255,255,255,0.9); 如果进度条盖在深色图片上 */
  text-align: right;
  font-family: monospace;
  font-weight: 500;
}

/* 核心卡片容器 */
.card-container {
  /* 弹性充满 */
  flex: 1;
  display: flex;
  flex-direction: column;
  
  /* 边距微调：左右保持，上下收紧 */
  margin: 10rpx 30rpx 20rpx 30rpx;
  
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.08); /* 更柔和的高级投影 */
  overflow: hidden;
  position: relative;
  
  /* ⛔️ 移除任何固定高度，依靠 Flex */
}

/* --- 插画区 (弹簧) --- */
.illustration-area {
  width: 100%;
  
  /* ⚠️ 核心策略：
     1. flex: 1 -> 占据剩余所有空间 (大屏图大，小屏图小)
     2. min-height -> 保证最小可视度，不能消失
  */
  flex: 1;
  min-height: 400rpx; /* 极限压缩高度 */
  
  position: relative;
  background-color: #F0F2F5;
  /* 既然高度可变，确保图片裁剪居中 */
  overflow: hidden;
}

.illustration {
  width: 100%;
  height: 100%;
  object-fit: cover; /* 关键：裁剪 */
  display: block;
}

/* 场景标签 (新增) */
.scenario-tag {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  padding: 8rpx 24rpx;
  border-radius: 99px;
  font-size: 22rpx;
  font-weight: 500;
  backdrop-filter: blur(8px);
  z-index: 5;
  letter-spacing: 1rpx;
}

/* --- 内容区域 (刚性) --- */
.content-area {
  /* ⚠️ flex-shrink: 0 -> 禁止被压缩，保证功能区完整 */
  flex-shrink: 0;
  
  display: flex;
  flex-direction: column;
  justify-content: flex-end; /* 内容靠下对齐 */
  
  margin-top: -40rpx; /* 向上重叠 */
  border-radius: 40rpx 40rpx 0 0;
  background: #fff;
  position: relative;
  z-index: 10;
  
  /* 紧凑内边距 - 减少 padding-top 让图片漏出来更多 */
  padding: 0rpx 30rpx 20rpx 30rpx;
  
  /* ⛔️ 关闭滚动，我们靠压缩图片来适配 */
  overflow: hidden;
}

/* --- 文字组容器 (固定高度版) --- */
.text-group {
  width: 100%;
  /* 增加高度，避免文字滚动 */
  height: 450rpx;
  
  /* 布局控制 */
  display: flex;
  flex-direction: column;
  /* ⚠️ 修改：改为顶端对齐，防止标签位置跳动 */
  justify-content: flex-start;
  align-items: flex-start;
  
  /* 间距保持 */
  margin-bottom: 20rpx;
  margin-top: 60rpx; /* 往下移动 60rpx */
  /* ⚠️ 新增：固定顶部内边距，确保标签位置稳定 */
  padding: 0 10rpx 0 10rpx; /* ⚠️ 减少 padding-top 让小标题和文本往上移 */
  
  /* 只有在极端情况下才允许文字内部滚动，不影响整体布局 */
  overflow-y: auto;
}

/* 1. 场景标签 (Q弹果冻风格) */
.tag-row {
  width: 100%;
  display: flex;
  justify-content: center; /* ⚠️ 核心：让标签居中 */
  margin-bottom: 10rpx;    /* 保持下边距 */
}

.category-capsule {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  
  /* 尺寸与排版 */
  font-size: 40rpx;
  font-weight: 700;       /* 加粗，看起来更饱满 */
  padding: 10rpx 32rpx;   /* 稍微加宽一点，显得更圆润 */
  border-radius: 999rpx;  /* 完全圆角 */
  line-height: 1;
  letter-spacing: 2rpx;
  
  /* --- 🍬 果冻质感配方 Start --- */
  
  /* 1. 颜色：深紫文字 */
  color: #7B40F2;
  
  /* 2. 背景：微渐变 (左上白 -> 右下淡紫) 模拟受光面 */
  background: linear-gradient(135deg, #FFFFFF 0%, #F4F0FF 100%);
  
  /* 3. 边框：极细的半透明白边，增加精致度 */
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  
  /* 4. 投影组合：
     - 第一层：外部弥散投影 (悬浮感)
     - 第二层：内部高光投影 (通透感)
  */
  box-shadow:
    0 8rpx 20rpx rgba(123, 64, 242, 0.15), /* 外部紫色光晕 */
    inset 0 2rpx 6rpx rgba(255, 255, 255, 1.0); /* 内部顶部高光 */
  
  /* --- 果冻质感配方 End --- */
  
  /* 开启硬件加速，防止渲染模糊 */
  transform: translateZ(0);
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1); /* 弹性过渡 */
}

/* 按压态：模拟被压扁的感觉 */
.category-capsule:active {
  transform: scale(0.92); /* 缩小 */
  background: #F0E6FF;    /* 颜色变深 */
  box-shadow:
    0 2rpx 8rpx rgba(123, 64, 242, 0.1), /* 投影收缩 */
    inset 0 2rpx 4rpx rgba(0,0,0,0.05);  /* 内部出现阴影 */
}

/* 2. 叙事文本 (宋体 - 文学感) */
.story-text {
  /* 字体栈：优先使用宋体，安卓回退到 Noto Serif 或衬线体 */
  font-family: "Songti SC", "Noto Serif SC", "SimSun", serif;

  /* 字号：16px -> 30rpx (稍微调小一点，适配紧凑布局) */
  font-size: 28rpx;

  /* 颜色：深碳灰，比纯黑更柔和 */
  color: #454545;

  /* 行高：1.6 (稍微调小一点，适配紧凑布局) */
  line-height: 1.6;

  /* 字重：宋体通常不需要加粗，Regular 最好看 */
  font-weight: 400;

  text-align: justify; /* 两端对齐，版面更整洁 */
  margin-bottom: 0;    /* 间距由下方元素的 margin-top 控制 */
}

/* 3. 提问文本 (黑体 - 力量感) */
.question-highlight {
  /* 字体栈：系统默认黑体 (PingFang / Roboto) */
  font-family: "Songti SC", "Noto Serif SC", "SimSun", serif;

  /* 间距：减小间隙 */
  margin-top: 10rpx;

  /* 字号：稍微调小一点，适配紧凑布局 */
  font-size: 30rpx;

  /* 颜色：纯黑，强调视觉重心 */
  color: #4A3B3B;

  /* 字重：加粗 */
  font-weight: 600;

  line-height: 1.4;
  text-align: left;
}

/* === 双层卡片 & 交互部分 === */
.answer-layout-wrapper {
  position: relative;
  width: 100%;
  height: 220rpx; /* 稍微调低一点，配合整体布局 */
  margin-top: 20rpx;
  margin-bottom: 60rpx;
}

.card-layer {
  position: absolute;
  top: 0;
  left: 20rpx;
  right: 20rpx;
  bottom: 0; /* 左右留点空隙 */
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 1. 底层垫片 (制造凹槽感) */
.background-card {
  /* 颜色稍微加深一点，偏冷灰 */
  background-color: #F2EFE9;
  z-index: 1;
  /* 增加一个微妙的内阴影，让它看起来是凹陷下去的 */
  box-shadow: inset 0 4rpx 12rpx rgba(0,0,0,0.05);
  /* 保持原有的缩放和位置 */
  transform: scale(0.95) translateY(10rpx);
  transform-origin: 50% 100%;
}

/* 2. 顶层操作卡 (制造悬浮感) */
.active-card {
  /* 改为纯白，更干净，对比度更高 */
  background-color: #FFFDF9;
  z-index: 10;
  /* ⚠️ 核心升级：使用更柔和、扩散的双层投影，制造高级悬浮感 */
  box-shadow:
    0 12rpx 28rpx -6rpx rgba(0, 0, 0, 0.08),
    0 4rpx 10rpx -4rpx rgba(0, 0, 0, 0.04);

  /* 增加极细微的边框界定边界 */
  border: 1rpx solid rgba(0,0,0,0.03);
  transform-origin: 50% 120%;
  will-change: transform, opacity; /* 告诉 GPU 做好准备 */
  transition: transform 0.1s, background-color 0.2s, box-shadow 0.2s, border-color 0.2s;
}

/* 3. 物理按压态 */
.card-hover {
  transform: scale(0.98) !important;
  background-color: #F7F4F0 !important;
}

/* 4. 选中高亮态 (光晕效果) */
.selected-mode {
  /* 使用非常淡的渐变蓝背景 */
  background: linear-gradient(135deg, #F5F9FF 0%, #FFFDF9 100%) !important;
  /* 边框色更柔和 */
  border-color: #8FB5F9 !important;
  transform: scale(0.96) !important;
  /* ⚠️ 核心升级：改为蓝色的扩散光晕，而不是黑色投影 */
  box-shadow: 0 8rpx 24rpx rgba(91, 143, 249, 0.25) !important;
}

.card-content {
  width: 100%;
  height: 100%;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.common-card-text {
  width: 100%;
  white-space: normal;
  word-break: break-word;
  text-align: center;
  font-size: 30rpx;
  line-height: 1.4;
  color: #4A4A4A; /* 稍微加深一点 */
  font-weight: 400;
  max-height: 100%;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.background-card .common-card-text {
  opacity: 0.4;
}

.tap-hint {
  position: absolute;
  bottom: 16rpx;
  left: 0;
  width: 100%;
  text-align: center;
  font-size: 20rpx;
  color: #BFA6D9;
  opacity: 0.7;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.hint-arrow {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #BFA6D9;
  font-size: 48rpx;
  opacity: 0.5;
}

.hint-arrow.left { left: 0; animation: bounceLeft 1.5s infinite; }
.hint-arrow.right { right: 0; animation: bounceRight 1.5s infinite; }
.hint-arrow.faded, .tap-hint.faded { opacity: 0 !important; animation: none; }

@keyframes bounceLeft {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(-6rpx); }
}

@keyframes bounceRight {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(6rpx); }
}

.ruler-wrapper {
  width: 100%;
  margin-top: 70rpx;
  margin-bottom: 10rpx;
  flex-shrink: 0; /* 绝对刚性，禁止压缩 */
  height: 140rpx; /* 给定一个明确的高度区域 */
}

/* 底部导航 */
.footer-actions {
  position: absolute;
  bottom: calc(30rpx + env(safe-area-inset-bottom));
  left: 0;
  width: 100%;
  padding: 0 50rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
  pointer-events: none; /* 让中间区域穿透 */
}

.text-action {
  font-size: 28rpx;
  padding: 20rpx;
  pointer-events: auto;
  transition: opacity 0.2s;
  display: flex;
  align-items: center;
}

.secondary { color: #999; }
.primary-text { color: #333; font-weight: 600; }
.text-hover { opacity: 0.6; }
.spacer { width: 1px; }

/* 定义一个禁用态样式 */
.btn-disabled {
  opacity: 0.3; /* 变淡 */
  filter: grayscale(100%); /* 去色 */
  /* pointer-events: none; 这里不加 none，为了让用户点击时能弹出提示 */
}

