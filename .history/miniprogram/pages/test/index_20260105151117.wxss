.test-container {
  min-height: 100vh;
  background: var(--bg-color);
  display: flex;
  flex-direction: column;
  padding-bottom: 120rpx;
}

/* 分段式进度条 */
.progress-header {
  width: 100%;
  padding: 20rpx 40rpx; /* 左右留白 */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  background: transparent;
}

.progress-track {
  position: relative;
  width: 100%;
  height: 12rpx; /* 细条 */
  background: #E0E0E0; /* 未完成颜色：浅灰 */
  border-radius: 999px;
  overflow: hidden; /* 裁剪圆角 */
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFB7B2, #BFA6D9); /* 莫兰迪渐变色 */
  border-radius: 999px;
  transition: width 0.3s ease; /* 丝滑动画 */
}

/* 阶段分割点 (小白点) */
.stage-marker {
  position: absolute;
  top: 0;
  width: 4rpx; /* 极细分割线 */
  height: 100%;
  background: rgba(255, 255, 255, 0.8); /* 半透明白 */
  z-index: 2;
  /* 使得分割线不遮挡圆角，视觉上是断开的 */
}

.stage-text {
  font-size: 24rpx;
  color: #999;
  text-align: right; /* 右对齐 */
  font-family: monospace; /* 等宽字体数字对齐 */
}

/* 核心卡片 */
.card-container {
  margin: 0 40rpx;
  background: var(--card-bg);
  border-radius: 40rpx;
  box-shadow: var(--card-shadow);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  position: relative; /* 为绝对定位提供基准 */
  padding-bottom: 180rpx; /* 底部留出大片空间给滑块 */
}

/* 插画区 */
.illustration-area {
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.illustration {
  width: 100%;
  height: 100%;
}

/* 标签 */
.tag {
  display: inline-block;
  background: #f0f0f0;
  color: #999;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  border-radius: 99px;
  margin-bottom: 24rpx;
  align-self: flex-start;
}

/* 题目 */
.question-text {
  font-size: 34rpx;
  line-height: 1.8;
  color: var(--text-body);
  text-align: left;
  margin-bottom: 40rpx;
}

/* 动态答案展示区 */
.answer-display {
  /* 1. 强制固定高度 (根据测试，200rpx 足够容纳最长文本) */
  height: 200rpx;
  
  /* 2. 居中对齐 (保证短文本在中间，不空荡) */
  display: flex;
  flex-direction: column;
  justify-content: center; /* 垂直居中 */
  align-items: flex-start; /* 左对齐 */
  
  /* 3. 防止溢出 */
  overflow: hidden;
  
  /* 4. 新增视觉样式 */
  background-color: #F7F9FC; /* 极淡的灰蓝/灰紫底色 */
  border-radius: 24rpx;
  margin: 0 40rpx 40rpx 40rpx; /* 增加边距 */
  padding: 30rpx; /* 内部留白 */
  
  /* 5. 文字样式优化 */
  color: #333;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.6;
}

.answer-text {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.6;
}

/* 刻度尺包装器 */
.ruler-wrapper {
  position: absolute; /* 绝对定位 */
  bottom: 40rpx;      /* 固定在卡片底部 */
  left: 0;
  width: 100%;
  padding: 0 40rpx;   /* 左右内边距 */
  box-sizing: border-box;
}

/* 底部按钮 */
.button-wrapper {
  position: fixed;
  bottom: 50rpx;
  left: 40rpx;
  right: 40rpx;
}

.next-button {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  color: #fff;
  background: linear-gradient(to right, #FFB7B2, #BFA6D9);
  border: none;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(191, 166, 217, 0.4);
  transition: all 0.3s ease;
}

.next-button::after {
  border: none;
}

.next-button[disabled] {
  opacity: 0.4;
  background: #ccc;
  box-shadow: none;
}

.next-button:not([disabled]):active {
  transform: scale(0.98);
  box-shadow: 0 4px 12px rgba(191, 166, 217, 0.3);
}
