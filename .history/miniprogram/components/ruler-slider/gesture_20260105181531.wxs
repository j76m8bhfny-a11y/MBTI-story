// 物理引擎 - 中心锚点逻辑

// 必须与 CSS .layout-guide 的 width 保持一致
var TRACK_WIDTH = 280; 

var startX = 0;
var startLeft = 140; // 初始中间 (280/2)
var lastLeft = 140;
var isDragging = false; // 新增：防止自己触发自己

/**
 * 触摸开始
 */
function touchStart(event, ownerInstance) {
  isDragging = true; // 标记开始拖拽
  var touch = event.touches[0];
  startX = touch.clientX;
  
  var cursor = ownerInstance.selectComponent('#ruler-cursor');
  
  // 1. 核心修复：按下瞬间，加上 .moving 类，移除 transition
  cursor.addClass('moving');

  // 获取当前 left 值
  var computedStyle = cursor.getComputedStyle(['left']);
  
  // 这里的 left 是相对于 .layout-guide (280px) 的
  if (computedStyle && computedStyle.left !== 'auto') {
    startLeft = parseInt(computedStyle.left);
  } else {
    startLeft = lastLeft;
  }
}

/**
 * 触摸移动 - 实时计算索引
 */
function touchMove(event, ownerInstance) {
  if (!isDragging) return; // 安全检查
  
  var touch = event.touches[0];
  var deltaX = touch.clientX - startX; // 计算手指移动了多少
  
  // 新位置 = 按下时的位置 + 手指移动距离
  var newLeft = startLeft + deltaX;

  // 边界限制
  if (newLeft < 0) newLeft = 0;
  if (newLeft > TRACK_WIDTH) newLeft = TRACK_WIDTH;

  // 移动滑块
  var cursor = ownerInstance.selectComponent('#ruler-cursor');
  cursor.setStyle({
    left: newLeft + 'px'
  });

  // 记录位置供下次使用
  lastLeft = newLeft;

  // 实时计算 Index (0-6)
  var step = TRACK_WIDTH / 6;
  var index = Math.round(newLeft / step);
  
  // 节流通讯：只有 Index 变了才通知
  ownerInstance.callMethod('onProjectedIndexChange', { index: index });
}

/**
 * 触摸结束
 */
function touchEnd(event, ownerInstance) {
  isDragging = false; // 标记结束
  
  // 吸附逻辑
  var step = TRACK_WIDTH / 6;
  var index = Math.round(lastLeft / step);
  var snapLeft = index * step;

  var cursor = ownerInstance.selectComponent('#ruler-cursor');
  
  // 2. 核心修复：松手瞬间，移除 .moving 类
  // 这样下面的 setStyle 就会带有 CSS 定义的 0.3s 回弹动画
  cursor.removeClass('moving');

  // 执行吸附
  cursor.setStyle({
    left: snapLeft + 'px'
  });
  
  // 更新最终位置
  lastLeft = snapLeft;
  // startLeft 不需要更新，它只在 touchStart 时有用
  
  // 发送最终确认事件
  ownerInstance.callMethod('onProjectedIndexChange', { index: index });
}

/**
 * --- 新增：核心同步函数 ---
 * 当外部（卡片）改变 value 时，这个函数会被触发
 */
function onValueChange(newValue, oldValue, ownerInstance, instance) {
  // 1. 如果正在拖拽中，忽略外部更新，防止打架
  if (isDragging) return;
  
  // 2. 空值检查
  if (newValue === null || newValue === undefined) return;

  // 3. 计算目标位置
  // newValue 是索引 (0-6)，需要转换为像素位置
  var step = TRACK_WIDTH / 6;
  var targetLeft = newValue * step;

  // 4. 强制移动滑块 (同步视觉)
  var cursor = ownerInstance.selectComponent('#ruler-cursor');
  // 确保有过渡动画，看起来更自然
  cursor.removeClass('moving'); 
  cursor.setStyle({
    left: targetLeft + 'px',
    transition: 'left 0.3s cubic-bezier(0.25, 0.8, 0.25, 1)'
  });

  // 5. 关键：同步 WXS 内部状态！
  // 这样下次你再摸滑块时，它就知道自己现在在哪了
  lastLeft = targetLeft;
}

module.exports = {
  touchStart: touchStart,
  touchMove: touchMove,
  touchEnd: touchEnd,
  onValueChange: onValueChange // 记得导出
};
