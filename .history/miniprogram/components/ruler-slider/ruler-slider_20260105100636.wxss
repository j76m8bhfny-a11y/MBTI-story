/* 容器 */
.ruler-container {
  position: relative;
  width: 100%;
  height: 140px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 20px;
  box-sizing: border-box;
}

/* 轨道背景 */
.ruler-track {
  position: absolute;
  top: 50%;
  left: 20px;
  right: 20px;
  height: 2px;
  background: var(--progress-bg);
  transform: translateY(-50%);
}

/* 刻度容器 */
.ruler-scales {
  position: absolute;
  top: 50%;
  left: 20px;
  right: 20px;
  height: 60px;
  transform: translateY(-50%);
}

/* 单个刻度项 */
.scale-item {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 刻度点基础样式 */
.dot {
  border-radius: 50%;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 中心 (0) - 空心圆环 */
.dot.hollow {
  width: 16px;
  height: 16px;
  background: transparent;
  border: 2px solid var(--progress-active);
  opacity: 0.6;
}

/* 两端极值 (±3) - 大光晕点 */
.dot.large-glow {
  width: 20px;
  height: 20px;
  background: var(--text-answer);
  box-shadow: 0 0 12px var(--text-answer), 0 0 24px rgba(255, 143, 143, 0.4);
}

/* 中间级 (±1) - 中等实心点 */
.dot.medium {
  width: 10px;
  height: 10px;
  background: var(--progress-active);
  opacity: 0.7;
}

/* 中间级 (±2) - 小实心点 */
.dot.small {
  width: 8px;
  height: 8px;
  background: var(--progress-active);
  opacity: 0.5;
}

/* 激活状态 */
.dot.active {
  transform: scale(1.3);
  opacity: 1 !important;
}

.dot.hollow.active {
  border-color: var(--text-answer);
  box-shadow: 0 0 8px var(--text-answer);
}

.dot.large-glow.active {
  box-shadow: 0 0 16px var(--text-answer), 0 0 32px rgba(255, 143, 143, 0.6);
}

.dot.medium.active,
.dot.small.active {
  background: var(--text-answer);
  box-shadow: 0 0 8px var(--text-answer);
}

/* 滑块光标 */
.ruler-cursor {
  position: absolute;
  top: 50%;
  width: 44px;
  height: 44px;
  transform: translate(-50%, -50%);
  z-index: 10;
  transition: left 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 水滴形状 */
.cursor-shape {
  width: 100%;
  height: 100%;
  background: var(--card-bg);
  border: 2px solid var(--progress-active);
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  box-shadow: var(--card-shadow);
  position: relative;
}

.cursor-shape::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 10px;
  height: 10px;
  background: var(--text-answer);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

/* 选项文字显示 */
.option-display {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  text-align: center;
  padding: 8px 20px;
  animation: fadeIn 0.3s ease;
}

.option-text {
  font-size: 15px;
  color: var(--text-body);
  font-weight: 500;
  line-height: 1.5;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
