// 物理引擎 - 实时拖动反馈

var startX = 0;
var currentX = 0;
var lastIndex = -1; // 用于节流

/**
 * 触摸开始
 */
function touchStart(event, ownerInstance) {
  var touch = event.touches[0];
  startX = touch.clientX;
  
  // 获取当前滑块位置
  var instance = ownerInstance.getDataset();
  currentX = instance.thumbLeft || 0;
}

/**
 * 触摸移动 - 实时计算索引
 */
function touchMove(event, ownerInstance) {
  var touch = event.touches[0];
  var instance = ownerInstance.getDataset();
  
  // 获取轨道宽度
  var trackWidth = instance.trackWidth || 0;
  
  // 计算偏移量
  var deltaX = touch.clientX - startX;
  var newX = currentX + deltaX;
  
  // 限制边界
  if (newX < 0) newX = 0;
  if (newX > trackWidth) newX = trackWidth;
  
  // 计算对应的索引 (0-6)
  var tempIndex = Math.round((newX / trackWidth) * 6);
  
  // 边界限制
  if (tempIndex < 0) tempIndex = 0;
  if (tempIndex > 6) tempIndex = 6;
  
  // 只有当索引变化时才通知逻辑层 (性能优化关键)
  if (tempIndex !== lastIndex) {
    lastIndex = tempIndex;
    // 调用组件逻辑层的方法
    ownerInstance.callMethod('onProjectedIndexChange', { 
      index: tempIndex,
      thumbLeft: newX
    });
  }
}

/**
 * 触摸结束
 */
function touchEnd(event, ownerInstance) {
  // 更新基础位置，防止下次拖动跳变
  var instance = ownerInstance.getDataset();
  currentX = instance.thumbLeft || 0;
  
  // 调用组件逻辑层的方法
  ownerInstance.callMethod('onTouchEnd', {});
}

module.exports = {
  touchStart: touchStart,
  touchMove: touchMove,
  touchEnd: touchEnd
};
